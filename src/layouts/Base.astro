---
import "../styles/base.css"

interface Props {
  title: string
  description?: string
  bare?: boolean
}

const { title, description = "浙大宁波理工学院计算机协会的社员卡与活动券。", bare = false } = Astro.props
const { user } = Astro.locals
const path = Astro.url.pathname
const links = [
  user?.member && { href: "/members", label: "社员" },
  { href: "/e", label: "活动" },
  user?.member && { href: "/scan", label: "核销" },
].filter((l) => !!l)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#05060a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ecebe6" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <script is:inline>
      const n = navigator
      try {
        const theme = localStorage.getItem("card:theme")
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme
      } catch {}
      if ((n.hardwareConcurrency || 8) <= 4 || (n.deviceMemory || 8) <= 4 || n.connection?.saveData) document.documentElement.dataset.lite = ""
    </script>
    <link rel="preload" href="/fonts/archivo-latin-wdth.woff2" as="font" type="font/woff2" crossorigin />
    <script type="speculationrules" is:inline>
      {
        "prerender": [
          {
            "where": { "and": [{ "or": [{ "href_matches": "/" }, { "href_matches": "/e/*" }, { "href_matches": "/members/*" }, { "href_matches": "/e" }, { "href_matches": "/members" }] }, { "not": { "href_matches": "/e/*/*" } }] },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body>
    <div class="light" aria-hidden="true" />
    <header hidden={bare}>
      <nav class="wrap">
        <a class="brand" href="/" aria-label="首页">
          <span class="ring" />
          <span>NBTCA <b>Cards</b></span>
        </a>
        <div class="links">
          {links.map(({ href, label }) => (
            <a href={href} aria-current={path === href || path.startsWith(`${href}/`) ? "page" : undefined}>{label}</a>
          ))}
        </div>
        {user
          ? (
              <a class="me" href={user.member ? "/me" : "/e"} title={user.email}>
                {user.picture
                  ? <img class="avatar" src={user.picture} alt="" referrerpolicy="no-referrer" />
                  : <span class="avatar" style={`--hue: ${user.member?.hue ?? 210}`}>{[...user.name][0]}</span>}
                <span class="who">{user.name}</span>
              </a>
            )
          : <a class="me signin" href={`/login?next=${encodeURIComponent(path)}`}>登录</a>}
      </nav>
    </header>
    <slot />
    <footer class="wrap" hidden={bare}>
      <span class="ring" />
      <p>浙大宁波理工学院计算机协会</p>
      <button class="toggle" type="button" data-theme-toggle>跟随系统</button>
      <button class="toggle" type="button" data-sound aria-pressed="true">音效开</button>
      {user && <a href="/logout">退出登录</a>}
    </footer>
    <script src="../cards/tilt.ts"></script>
    <script>
      import { setSound, soundOn } from "../lib/sound"

      const button = document.querySelector<HTMLButtonElement>("[data-sound]")!
      const show = () => {
        button.setAttribute("aria-pressed", String(soundOn()))
        button.textContent = soundOn() ? "音效开" : "音效关"
      }
      button.addEventListener("click", () => {
        setSound(!soundOn())
        show()
      })
      show()

      const THEMES = ["system", "light", "dark"] as const
      const LABELS = { system: "跟随系统", light: "浅色", dark: "深色" }
      const root = document.documentElement
      const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")!
      const current = () => (root.dataset.theme as (typeof THEMES)[number] | undefined) ?? "system"
      const label = () => (themeButton.textContent = LABELS[current()])
      themeButton.addEventListener("click", () => {
        const next = THEMES[(THEMES.indexOf(current()) + 1) % THEMES.length]!
        if (next === "system") delete root.dataset.theme
        else root.dataset.theme = next
        try {
          localStorage.setItem("card:theme", next)
        } catch {}
        label()
      })
      label()

      if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js")
      const mark = () => root.toggleAttribute("data-offline", !navigator.onLine)
      addEventListener("online", mark)
      addEventListener("offline", mark)
      mark()
    </script>
    <p class="offline" role="status">没有网络，显示的是上次打开时的内容</p>
  </body>
</html>

<style>
  .offline {
    position: fixed;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 50;
    display: none;
    margin: 0;
    padding: 0.55rem 1rem;
    border: 1px solid rgb(245 184 61 / 0.4);
    border-radius: 99px;
    background: var(--nav);
    backdrop-filter: blur(14px);
    color: var(--warn);
    font-size: 0.82rem;
    white-space: nowrap;
    translate: -50% 0;
  }

  :global([data-offline]) .offline {
    display: block;
  }

  header {
    view-transition-name: nav;
    position: sticky;
    top: calc(env(safe-area-inset-top, 0px) + 12px);
    z-index: 20;
    padding-block: 12px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--nav);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.8);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.25rem 0.8rem 0.25rem 0.3rem;
    text-decoration: none;
    font: 600 0.82rem / 1 var(--wide);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .brand b {
    font-weight: 800;
    color: var(--glow);
  }

  .ring {
    display: block;
    width: 30px;
    aspect-ratio: 1;
    background: currentColor;
    mask: url("/logo.svg") center / contain no-repeat;
  }

  .links {
    display: flex;
    gap: 0.15rem;
    margin-inline: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .links a,
  .me {
    padding: 0.55rem 0.9rem;
    border-radius: 99px;
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--muted);
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }

  .links a:hover,
  .links a[aria-current] {
    color: var(--fg);
    background: rgb(var(--tint) / 0.08);
  }

  .me {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.25rem 0.9rem 0.25rem 0.25rem;
    color: var(--fg);
  }

  .me:hover {
    background: rgb(var(--tint) / 0.08);
  }

  .me.signin {
    padding-inline: 1.1rem;
    background: var(--fg);
    color: var(--bg);
    font-weight: 650;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(135deg, oklch(0.7 0.16 var(--hue)), oklch(0.45 0.16 calc(var(--hue) + 40)));
    font-size: 0.85rem;
    font-weight: 700;
    object-fit: cover;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 6rem;
    padding-block: 2rem calc(env(safe-area-inset-bottom, 0px) + 2rem);
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--faint);
  }

  footer p {
    margin: 0 auto 0 0;
  }

  .toggle {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .toggle:hover {
    color: var(--fg);
  }

  footer .ring {
    width: 22px;
  }

  @media (max-width: 640px) {
    .brand span:last-child,
    .who {
      display: none;
    }

    .me {
      padding-right: 0.25rem;
    }
  }
</style>
