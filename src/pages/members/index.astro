---
import MemberCard from "../../cards/MemberCard.astro"
import Base from "../../layouts/Base.astro"
import { listMembers } from "../../lib/db"

const members = await listMembers()
const sections = new Set(members.map((m) => m.section).filter(Boolean)).size
---

<Base title="社员 · NBTCA">
  <main class="wrap">
    <header>
      <div>
        <p class="eyebrow reveal">Members</p>
        <h1 class="title reveal" style="--i: 1">社员墙</h1>
      </div>
      <dl class="stats reveal" style="--i: 2">
        <div><dt>社员</dt><dd>{members.length}</dd></div>
        <div><dt>部门</dt><dd>{sections}</dd></div>
      </dl>
    </header>
    <ul data-pluck>
      {members.map((member, i) => (
        <li class="rise" style={`--r: ${((i * 7) % 5) - 2}deg`}>
          <MemberCard member={member} size="thumb" />
        </li>
      ))}
    </ul>
  </main>
</Base>

<script>
  import "../../cards/pluck"
</script>

<style>
  main {
    display: grid;
    gap: 4rem;
    padding-block: 4rem;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  header > div {
    display: grid;
    gap: 1rem;
  }

  .stats {
    display: flex;
    gap: 2.5rem;
    margin: 0;
  }

  .stats dt {
    font-size: 0.8rem;
    color: var(--faint);
  }

  .stats dd {
    margin: 0.3rem 0 0;
    font: 800 2.6rem / 1 var(--wide);
    font-stretch: 125%;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
    gap: 3rem 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    rotate: var(--r);
    transition: rotate 0.5s var(--ease), translate 0.5s var(--ease), scale 0.5s var(--ease);
    content-visibility: auto;
    contain-intrinsic-size: auto 300px;
  }

  li :global(.card) {
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }

  /* content-visibility implies paint containment, which would clip a card lifted off its slot, and the
     scroll-driven entry would leave a card in a half-visible row see-through while held. */
  ul li[data-plucked] {
    z-index: 5;
    content-visibility: visible;
    animation: none;
  }

  li[data-plucked] :global(.card) {
    cursor: grabbing;
    filter: drop-shadow(0 2rem 2.5rem rgb(0 0 0 / 0.55));
  }

  li:hover,
  li:focus-within {
    rotate: 0deg;
    translate: 0 -10px;
    scale: 1.04;
    z-index: 1;
  }
</style>
