---
import MemberCard from "../../cards/MemberCard.astro"
import PassShelf from "../../components/PassShelf.astro"
import RepairTally from "../../components/RepairTally.astro"
import SharePoster from "../../components/SharePoster.astro"
import Base from "../../layouts/Base.astro"
import { getMember, keptBy } from "../../lib/db"
import { metWhere } from "../../lib/meets"

const me = Astro.locals.user!.member!
const id = Astro.params.id!
const [member, kept, met] = await Promise.all([getMember(id), keptBy(id), id === me.id ? [] : metWhere(me.id, id)])
if (!member) return new Response(null, { status: 404 })
const mine = member.id === me.id
---

<Base title={`${member.name} · NBTCA 社员卡`}>
  <main class="wrap" style={`--hue: ${member.hue}`}>
    <div class="stage">
      <div class="beam" />
      <MemberCard member={member} size="full" stamps={kept} />
      <div class="floor" />
    </div>
    <div class="caption reveal">
      <h1>{member.name}</h1>
      <p class="muted">{[member.section, member.role].filter(Boolean).join(" · ")} · {member.joined} 年入会</p>
      {met.length > 0 && (
        <p class="met" data-fresh={Astro.url.searchParams.has("met") ? "" : undefined}>
          在 {met.map((e, i) => <>{i > 0 && "、"}<a href={`/e/${e.slug}`}>{e.title}</a></>)} 认识
        </p>
      )}
      <p class="hint">点击卡片翻到背面</p>
      {mine && (
        <div class="row">
          <a class="action" href="/me">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9a2.83 2.83 0 0 0-4-4L4 16z" /><path d="m13.5 6.5 4 4" /></svg>
            装扮卡片
          </a>
          <SharePoster
            kind="badge"
            label="吧唧壁纸"
            hint="长按保存，再到吧唧的「连接 → 手机管理」上传。"
            sources={{ background: ".front .sky img", portrait: ".front .subject img" }}
            spec={{ word: member.word || member.alias, name: member.name, sub: [member.section, member.role].filter(Boolean).join(" · "), hue: member.hue }}
          />
        </div>
      )}
    </div>
    {kept.length > 0 && (
      <div class="kept">
        <PassShelf stubs={kept} guest={false} eyebrow="Ticket stubs" title={`去过的 ${kept.length} 场活动`} />
      </div>
    )}
    <div class="repairs">
      <RepairTally alias={member.alias} eyebrow="Repairs" title="修过的电脑" />
    </div>
  </main>
</Base>

<style>
  main {
    display: grid;
    justify-items: center;
    gap: 2.5rem;
    padding-block: 3rem 2rem;
  }

  .stage {
    position: relative;
    display: grid;
    justify-items: center;
    width: 100%;
  }

  .beam {
    position: absolute;
    inset: -10% 0 0;
    z-index: -1;
    background: conic-gradient(from 180deg at 50% -10%, transparent 160deg, oklch(0.7 0.14 var(--hue) / 0.25) 180deg, transparent 200deg);
    mask: linear-gradient(#000 40%, transparent);
  }

  .floor {
    width: min(380px, 80%);
    height: 40px;
    margin-top: 1.5rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, oklch(0.6 0.16 var(--hue) / 0.5), transparent);
    filter: blur(14px);
  }

  .kept {
    justify-self: stretch;
    padding-top: 3rem;
  }

  .caption {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }

  .caption p {
    margin: 0;
  }

  .repairs {
    justify-self: stretch;
  }

  .met {
    font-size: 0.92rem;
  }

  .met a {
    color: var(--fg);
  }

  .met[data-fresh] {
    animation: met 1.2s var(--ease) both;
  }

  @keyframes met {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  .hint {
    font-size: 0.82rem;
    color: var(--faint);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
</style>
