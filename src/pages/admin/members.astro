---
import Base from "../../layouts/Base.astro"
import { db, getMember, listMembers, randomId, type Member } from "../../lib/db"

const editing = Astro.url.searchParams.get("member")
const thisYear = new Date().getFullYear()
let error = ""
let notice = ""

type Row = Pick<Member, "email" | "name" | "alias" | "section" | "role" | "joined" | "github">

const upsert = (row: Row) =>
  db()
    .prepare(
      `INSERT INTO members (id, email, name, alias, section, role, joined, github, created_at)
       VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)
       ON CONFLICT (email) DO UPDATE SET name = ?3, alias = ?4, section = ?5, role = ?6, joined = ?7, github = ?8`,
    )
    .bind(randomId(9), row.email, row.name, row.alias, row.section, row.role, row.joined, row.github, Date.now())

function parse(fields: string[]): Row | string {
  const [email = "", name = "", alias = "", section = "", role = "", joined = "", github = ""] = fields.map((f) => f.trim())
  if (!/^[^@\s]+@[^@\s]+$/.test(email)) return `邮箱「${email}」格式不对`
  if (!name) return `${email} 缺少姓名`
  const year = joined ? Number(joined) : thisYear
  if (!Number.isInteger(year) || year < 2000 || year > thisYear) return `${email} 的入会年份不对`
  return {
    email: email.toLowerCase(),
    name,
    alias: alias || name,
    section,
    role: role || "社员",
    joined: year,
    github: github.replace(/^@/, "") || null,
  }
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  const action = form.get("action")
  if (action === "delete" && editing) {
    await db().prepare("DELETE FROM members WHERE id = ?").bind(editing).run()
    return Astro.redirect("/admin/members", 303)
  }
  if (action === "import") {
    const lines = String(form.get("rows") ?? "").split("\n").filter((l) => l.trim())
    const rows = lines.map((l) => parse(l.split(/[,，\t]/)))
    const bad = rows.find((r) => typeof r === "string")
    if (bad) error = `${bad}，这次没有导入任何人。`
    else {
      await db().batch((rows as Row[]).map(upsert))
      notice = `已导入 ${rows.length} 位社员。`
    }
  } else {
    const fields = ["email", "name", "alias", "section", "role", "joined", "github"].map((k) => String(form.get(k) ?? ""))
    const row = parse(fields)
    if (typeof row === "string") error = `${row}。`
    else if (editing) {
      await db()
        .prepare("UPDATE members SET email = ?, name = ?, alias = ?, section = ?, role = ?, joined = ?, github = ? WHERE id = ?")
        .bind(row.email, row.name, row.alias, row.section, row.role, row.joined, row.github, editing)
        .run()
        .catch(() => (error = "这个邮箱已经属于另一位社员。"))
      if (!error) return Astro.redirect("/admin/members", 303)
    } else {
      await upsert(row).run()
      return Astro.redirect("/admin/members", 303)
    }
  }
}

const members = await listMembers()
const member = editing ? await getMember(editing) : null
if (editing && !member) return Astro.redirect("/admin/members")
---

<Base title="社员名单 · NBTCA">
  <main>
    <nav class="tabs"><a href="/admin">活动</a><a href="/admin/members" aria-current="page">社员名单</a></nav>
    <section>
      <h1>社员名单</h1>
      <p class="muted">只有名单里的邮箱登录后才算社员。登录用的是 Logto 账号的邮箱。</p>
      {error && <p class="notice error">{error}</p>}
      {notice && <p class="notice">{notice}</p>}
      <table>
        <thead><tr><th>姓名</th><th>邮箱</th><th>部门</th><th>身份</th><th>入会</th></tr></thead>
        <tbody>
          {members.map((m) => (
            <tr aria-current={m.id === editing ? "true" : undefined}>
              <td><a href={`/admin/members?member=${m.id}`}>{m.name}</a></td>
              <td>{m.email}</td>
              <td>{m.section}</td>
              <td>{m.role}</td>
              <td>{m.joined}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section>
      <h2>{member ? `编辑「${member.name}」` : "添加社员"}</h2>
      <form class="form" method="post">
        <label>邮箱<input name="email" type="email" required value={member?.email} /></label>
        <label>姓名<input name="name" required value={member?.name} /></label>
        <label>代号<input name="alias" value={member?.alias} /><small>印在社员卡上的大字，留空就用姓名。</small></label>
        <label>部门<input name="section" value={member?.section} /></label>
        <label>身份<input name="role" value={member?.role} placeholder="社员" /></label>
        <label>入会年份<input name="joined" type="number" min="2000" max={thisYear} value={member?.joined ?? thisYear} /></label>
        <label>GitHub 用户名<input name="github" value={member?.github ?? ""} /></label>
        <div class="row">
          <button class="button">保存</button>
          {member && <button class="button ghost" name="action" value="delete">删除这位社员</button>}
        </div>
      </form>
    </section>

    {!member && (
      <section>
        <h2>批量导入</h2>
        <form class="form" method="post">
          <label>
            每行一位社员
            <textarea name="rows" rows="6" placeholder="zhangsan@example.com,张三,Kernel,技术部,社员,2025,zhangsan" />
            <small>依次填写邮箱、姓名、代号、部门、身份、入会年份和 GitHub 用户名，用逗号隔开，后面几项可以留空。已经在名单里的邮箱会更新资料，社员自己装扮的内容不受影响。</small>
          </label>
          <button class="button" name="action" value="import">导入</button>
        </form>
      </section>
    )}
  </main>
</Base>

<style>
  main {
    max-width: 1080px;
    margin: 0 auto;
    padding-block: 4vh 10vh;
    display: grid;
    gap: 3.5rem;
  }

  section {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  section > p {
    margin: 0;
  }

  form {
    max-width: 36rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
