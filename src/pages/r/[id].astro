---
import RepairTag from "../../cards/RepairTag.astro"
import Timeline from "../../components/Timeline.astro"
import Base from "../../layouts/Base.astro"
import { formatSerial } from "../../lib/format"
import { STEPS } from "../../lib/repair"

const id = Number(Astro.params.id)
if (!Number.isSafeInteger(id) || id < 1) return new Response(null, { status: 404 })
const serial = formatSerial(id)
---

<Base title={`维修单 ${serial} · NBTCA`} description="计算机协会维修单的进度。">
  <main class="wrap" data-repair={id}>
    <div class="stage">
      <RepairTag id={id} />
      <div class="spot" />
    </div>
    <section class="info">
      <span class="chip" data-chip>读取中</span>
      <h1><span data-title>维修单</span><small>{serial}</small></h1>
      <p class="problem" data-summary hidden />
      <Timeline steps={STEPS.map((s) => ({ label: s.label, at: null, done: false }))} halted />
      <a class="action" href={`https://nbtca.space/repair/ticket-detail?eventId=${id}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9" /><path d="M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10" /></svg>
        在维修系统查看
      </a>
    </section>
  </main>
</Base>

<script>
  import { fetchRepair, type Repair } from "../../lib/repair"
  import { formatDot, formatWhen } from "../../lib/format"

  const HOLES = [17.75, 39.25, 60.75, 82.25]
  const CHIPS = [
    { tone: "warn", text: "等待接单" },
    { tone: "warn", text: "维修中" },
    { tone: "ok", text: "已修好" },
    { tone: "ok", text: "已完成" },
  ]

  const main = document.querySelector<HTMLElement>("[data-repair]")!
  const tag = main.querySelector<HTMLElement>("[data-repair-tag]")!
  const chip = main.querySelector<HTMLElement>("[data-chip]")!
  const text = (selector: string, value: string) => (main.querySelector(selector)!.textContent = value)

  function show(r: Repair) {
    const reached = r.steps.findLastIndex((s) => s.done)
    const { tone, text: label } = r.cancelled ? { tone: "", text: "已取消" } : CHIPS[reached]!
    chip.dataset.tone = tone
    chip.textContent = label
    text("[data-title]", r.model || "维修单")
    text("[data-model]", r.model || "未填写机型")
    text("[data-problem]", r.problem)
    const summary = main.querySelector<HTMLElement>("[data-summary]")!
    summary.textContent = r.problem
    summary.hidden = !r.problem

    const holes = r.steps.flatMap((s, i) => (s.done ? [`radial-gradient(circle at ${HOLES[i]}cqi 92cqi, #0000 2.1cqi, #000 2.3cqi)`] : []))
    tag.style.setProperty("--holes", holes.join(", "))
    const next = r.cancelled ? -1 : r.steps.findIndex((s) => !s.done)
    const on = (el: HTMLElement, key: string, value: boolean) => (value ? (el.dataset[key] = "") : delete el.dataset[key])
    tag.querySelectorAll<HTMLElement>("[data-step]").forEach((li, i) => on(li, "done", r.steps[i]!.done))
    main.querySelectorAll<HTMLElement>(".timeline [data-step]").forEach((li, i) => {
      on(li, "done", r.steps[i]!.done)
      on(li, "next", i === next)
      li.querySelector("[data-at]")!.textContent = r.steps[i]!.at ? formatWhen(r.steps[i]!.at!) : ""
    })

    const repairer = tag.querySelector<HTMLElement>("[data-repairer]")!
    if (r.repairer) {
      repairer.querySelector("b")!.textContent = r.repairer.alias
      repairer.querySelector(".initial")!.textContent = [...r.repairer.alias][0]!
      const avatar = repairer.querySelector("img")!
      if (r.repairer.avatar) {
        avatar.onload = () => (avatar.hidden = false)
        avatar.src = r.repairer.avatar
      }
    }
    repairer.hidden = !r.repairer

    on(tag, "torn", r.done)
    text("[data-stub-note]", r.cancelled ? "已取消" : "完成时撕下")
    const kind = r.done ? "done" : r.cancelled ? "cancelled" : null
    const last = r.steps.findLast((s) => s.at)?.at
    for (const stamp of tag.querySelectorAll<HTMLElement>("[data-stamp]")) {
      stamp.hidden = stamp.dataset.stamp !== kind
      if (last) stamp.querySelector("[data-stamp-date]")!.textContent = `NBTCA · ${formatDot(last)}`
    }
  }

  fetchRepair(Number(main.dataset.repair)).then(
    (r) => (r ? show(r) : ((chip.textContent = "没有这张维修单"), text("[data-model]", "没有这张维修单"))),
    () => (chip.textContent = "维修系统暂时连不上"),
  )
</script>

<style>
  main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 3rem 5rem;
    min-height: calc(100svh - 8rem);
    padding-block: 2rem 4rem;
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: 2rem;
  }

  .spot {
    position: absolute;
    inset: 10% 5% -5%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(200 55 42 / 0.18), transparent);
    filter: blur(30px);
  }

  .info {
    display: grid;
    justify-items: start;
    gap: 1.6rem;
  }

  h1 {
    display: grid;
    gap: 0.6rem;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  h1 small {
    font: 600 0.8rem / 1 var(--wide);
    letter-spacing: 0.18em;
    color: var(--faint);
  }

  .problem {
    margin: 0;
    max-width: 32rem;
    color: var(--muted);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    main {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      min-height: 0;
    }

    .stage :global(.repair-tag) {
      width: min(280px, 72vw);
    }
  }
</style>
