---
import Base from "../layouts/Base.astro"
import { listEvents } from "../lib/db"

const events = await listEvents()
---

<Base title="核销 · NBTCA">
  <main class="wrap">
    <header class="reveal">
      <p class="eyebrow">Check-in</p>
      <h1>扫码核销</h1>
    </header>
    <div class="viewfinder reveal" style="--i: 1">
      <video muted playsinline data-video></video>
      <span class="corners" aria-hidden="true" />
      <span class="line" aria-hidden="true" />
      <button class="button" type="button" data-start>打开摄像头</button>
    </div>
    <output class="result" data-result hidden>
      <span class="icon" aria-hidden="true" />
      <strong data-headline></strong>
      <span data-detail></span>
    </output>
    <details class="panel manual reveal" style="--i: 2">
      <summary>扫不出来？按编号核销</summary>
      <form class="form" data-manual>
        <label>
          活动
          <select name="event" required>
            {events.map((e) => <option value={e.slug}>{e.title}</option>)}
          </select>
        </label>
        <label>
          券上的编号
          <input name="serial" type="number" min="1" inputmode="numeric" required />
        </label>
        <button class="button ghost">核销</button>
      </form>
    </details>
  </main>
</Base>

<script>
  const video = document.querySelector<HTMLVideoElement>("[data-video]")!
  const start = document.querySelector<HTMLButtonElement>("[data-start]")!
  const result = document.querySelector<HTMLOutputElement>("[data-result]")!
  const headline = result.querySelector<HTMLElement>("[data-headline]")!
  const detail = result.querySelector<HTMLElement>("[data-detail]")!
  const time = (ms: number) => new Date(ms).toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" })

  interface Outcome {
    status: "ok" | "already" | "unknown" | "early" | "ended"
    name?: string
    serial?: number
    title?: string
    redeemedAt?: number
    startsAt?: string
  }

  async function redeem(body: { id: string } | { event: string; serial: number }) {
    const response = await fetch("/api/redeem", { method: "POST", body: JSON.stringify(body) })
    const outcome: Outcome = response.status === 404 ? { status: "unknown" } : await response.json()
    result.dataset.status = outcome.status
    result.hidden = true
    void result.offsetWidth
    result.hidden = false
    headline.textContent = {
      ok: "核销成功",
      already: "已经核销过",
      unknown: "无效的通行证",
      early: "还没到核销时间",
      ended: "活动已经结束",
    }[outcome.status]
    const who = `${outcome.name} · ${outcome.title} · № ${String(outcome.serial).padStart(4, "0")}`
    detail.textContent = {
      ok: who,
      already: `${who} · ${time(outcome.redeemedAt!)} 已入场`,
      unknown: "这张码不属于任何活动。",
      early: `${who} · 活动开始前一小时起才能核销，活动 ${new Date(outcome.startsAt!).toLocaleString("zh-CN", { dateStyle: "medium", timeStyle: "short" })} 开始`,
      ended: `${who} · 这张券没有在活动期间使用`,
    }[outcome.status]
    navigator.vibrate?.(outcome.status === "ok" ? 80 : [60, 60, 60])
  }

  const passId = (text: string) => {
    try {
      return new URL(text).hash.slice(1) || null
    } catch {
      return /^[\w-]{16,}$/.test(text) ? text : null
    }
  }

  // Scanning a pass with the phone's own camera app lands here with the pass in the hash.
  if (location.hash.length > 1) {
    redeem({ id: location.hash.slice(1) })
    history.replaceState(null, "", location.pathname)
  }

  type Detect = (source: HTMLVideoElement) => Promise<string | null>

  async function detector(): Promise<Detect> {
    if ("BarcodeDetector" in window) {
      const native = new (window as any).BarcodeDetector({ formats: ["qr_code"] })
      return async (source) => (await native.detect(source))[0]?.rawValue ?? null
    }
    const { default: jsQR } = await import("jsqr")
    const canvas = new OffscreenCanvas(1, 1)
    const context = canvas.getContext("2d", { willReadFrequently: true })!
    return async (source) => {
      const scale = Math.min(1, 640 / source.videoWidth)
      canvas.width = Math.round(source.videoWidth * scale)
      canvas.height = Math.round(source.videoHeight * scale)
      context.drawImage(source, 0, 0, canvas.width, canvas.height)
      const { data } = context.getImageData(0, 0, canvas.width, canvas.height)
      return jsQR(data, canvas.width, canvas.height, { inversionAttempts: "dontInvert" })?.data ?? null
    }
  }

  start.addEventListener("click", async () => {
    try {
      video.srcObject = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" } })
    } catch {
      start.textContent = "无法打开摄像头"
      return
    }
    await video.play()
    start.hidden = true
    const detect = await detector()
    let last = ""
    let lastAt = 0
    const tick = async () => {
      if (video.readyState >= 2) {
        const id = passId((await detect(video).catch(() => null)) ?? "")
        if (id && (id !== last || Date.now() - lastAt > 4000)) {
          last = id
          lastAt = Date.now()
          await redeem({ id })
        }
      }
      setTimeout(tick, 250)
    }
    tick()
  })

  document.querySelector<HTMLFormElement>("[data-manual]")!.addEventListener("submit", (e) => {
    e.preventDefault()
    const form = new FormData(e.target as HTMLFormElement)
    redeem({ event: String(form.get("event")), serial: Number(form.get("serial")) })
  })
</script>

<style>
  main {
    max-width: 30rem;
    display: grid;
    gap: 1.5rem;
    padding-block: 2rem;
  }

  header {
    display: grid;
    gap: 0.6rem;
  }

  h1 {
    font-size: 2rem;
  }

  .viewfinder {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 2rem;
    background:
      radial-gradient(closest-side, rgb(59 141 255 / 0.15), transparent),
      rgb(255 255 255 / 0.03);
    box-shadow: 0 0 0 1px var(--line) inset, 0 30px 60px -30px rgb(0 0 0 / 0.8);
  }

  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .corners {
    --c: rgb(255 255 255 / 0.85);
    --l: 2.4rem;
    position: absolute;
    inset: 14%;
    background:
      linear-gradient(var(--c), var(--c)) 0 0 / var(--l) 3px,
      linear-gradient(var(--c), var(--c)) 0 0 / 3px var(--l),
      linear-gradient(var(--c), var(--c)) 100% 0 / var(--l) 3px,
      linear-gradient(var(--c), var(--c)) 100% 0 / 3px var(--l),
      linear-gradient(var(--c), var(--c)) 0 100% / var(--l) 3px,
      linear-gradient(var(--c), var(--c)) 0 100% / 3px var(--l),
      linear-gradient(var(--c), var(--c)) 100% 100% / var(--l) 3px,
      linear-gradient(var(--c), var(--c)) 100% 100% / 3px var(--l);
    background-repeat: no-repeat;
    pointer-events: none;
  }

  .line {
    position: absolute;
    inset: 14% 14% auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--glow), transparent);
    box-shadow: 0 0 16px var(--glow);
    animation: sweep 2.4s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes sweep {
    to {
      translate: 0 calc(72cqw - 2px);
    }
  }

  .viewfinder {
    container-type: inline-size;
  }

  [data-start] {
    position: relative;
  }

  .result {
    --tone: var(--ok);
    position: sticky;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 1rem);
    z-index: 5;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.25rem 1rem;
    padding: 1.25rem 1.4rem;
    border-radius: 1.5rem;
    background: color-mix(in oklch, var(--tone) 18%, #0b0d12);
    box-shadow: 0 0 0 1px color-mix(in oklch, var(--tone) 50%, transparent) inset, 0 24px 50px -20px rgb(0 0 0 / 0.9);
    animation: rise 0.45s var(--ease);
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 30px;
    }
  }

  .icon {
    grid-row: span 2;
    width: 2.75rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--tone);
    mask: radial-gradient(closest-side, #000 98%, transparent);
  }

  .result strong {
    font-size: 1.35rem;
    color: var(--tone);
  }

  .result span:last-child {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted);
  }

  [data-status="already"],
  [data-status="early"] {
    --tone: var(--warn);
  }

  [data-status="unknown"],
  [data-status="ended"] {
    --tone: var(--bad);
  }

  .manual summary {
    cursor: pointer;
    color: var(--muted);
  }

  .manual[open] summary {
    margin-bottom: 1.25rem;
  }
</style>
