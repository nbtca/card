---
import { qrCode } from "../../cards/pass"
import MemberCard from "../../cards/MemberCard.astro"
import Base from "../../layouts/Base.astro"
import { getMember, keptBy } from "../../lib/db"

const me = Astro.locals.user!.member!
const [member, kept] = await Promise.all([getMember(me.id), keptBy(me.id)])
const link = `${Astro.url.origin}/members/${me.id}`.replace(/^http:/, "https:")
const qr = qrCode(link)
---

<Base title="打印实体卡 · NBTCA" bare>
  <main class="wrap">
    <header class="screen">
      <a class="back" href="/me">← 装扮卡片</a>
      <h1>实体卡</h1>
      <p class="muted">标准证件卡大小，正反两页。打印时选实际大小、无边距。</p>
      <p class="muted">NFC 标签写入 <code>{link}</code></p>
      <button class="button" type="button" data-print>打印</button>
    </header>
    <div class="sheets">
      {[false, true].map((back) => (
        <section class="sheet" data-side={back ? "back" : "front"}>
          <MemberCard member={member!} size="full" stamps={kept} />
          <footer class="strip">
            <svg viewBox={`-1 -1 ${qr.size + 2} ${qr.size + 2}`} shape-rendering="crispEdges" aria-hidden="true"><path d={qr.path} /></svg>
            <span>
              <b>{back ? "浙大宁波理工学院计算机协会" : member!.name}</b>
              <small>{link.replace(/^https:\/\//, "")}</small>
            </span>
          </footer>
        </section>
      ))}
    </div>
  </main>
</Base>

<script>
  document.querySelector("[data-print]")!.addEventListener("click", () => print())
</script>

<style>
  @page {
    size: 54mm 85.6mm;
    margin: 0;
  }

  main {
    display: grid;
    gap: 2.5rem;
    padding-block: 3rem;
  }

  .screen {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .back {
    font-size: 0.88rem;
    color: var(--muted);
    text-decoration: none;
  }

  h1 {
    font-size: 2rem;
  }

  .screen p {
    margin: 0;
  }

  code {
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  .sheets {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }

  /* CR80, the ID-1 card. The member card is 5:7, so a 10 mm strip below makes up the height. */
  .sheet {
    display: grid;
    grid-template-rows: auto 1fr;
    width: 54mm;
    height: 85.6mm;
    overflow: hidden;
    border-radius: 3mm;
    background: #0d1117;
    color: #fff;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .sheet :global(.card) {
    width: 54mm;
  }

  .sheet :global(.face) {
    border-radius: 0;
    clip-path: none;
  }

  /* Print flattens 3D, so a turned card would show its back mirrored; each sheet keeps one face, unturned. */
  .sheet :global(:is(.flip, .back)) {
    transform: none !important;
  }

  .sheet[data-side="front"] :global(.back),
  .sheet[data-side="back"] :global(.front) {
    display: none;
  }

  .strip {
    display: flex;
    align-items: center;
    gap: 2mm;
    padding: 0 3mm;
    font-size: 2.2mm;
  }

  .strip svg {
    flex: none;
    width: 7mm;
    height: 7mm;
    background: #fff;
    fill: #0d1117;
  }

  .strip span {
    display: grid;
    gap: 0.6mm;
    min-width: 0;
  }

  .strip b {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .strip small {
    font-size: 1.7mm;
    opacity: 0.6;
  }

  @media print {
    :global(body),
    :global(html) {
      padding: 0;
      background: none;
    }

    :global(body)::before,
    :global(body)::after,
    :global(.offline) {
      display: none;
    }

    :global(.light) {
      display: none;
    }

    main {
      display: block;
      padding: 0;
    }

    .screen {
      display: none;
    }

    .sheets {
      display: block;
    }

    .sheet {
      border-radius: 0;
      break-after: page;
    }

    .sheet:last-child {
      break-after: auto;
    }

    /* Chromium drops SVG masks when printing, so the logo is drawn as an image and turned white. */
    .sheet :global(.ring) {
      mask: none;
      background: url("/logo.svg") center / contain no-repeat;
      filter: brightness(0) invert(1);
      animation: none;
    }
  }
</style>
