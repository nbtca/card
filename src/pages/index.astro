---
import { passDesign } from "../cards/pass"
import MemberCard from "../cards/MemberCard.astro"
import EventList from "../components/EventList.astro"
import Base from "../layouts/Base.astro"
import { countMembers, upcomingEvents } from "../lib/db"
import { showcaseEvent, showcaseMember } from "../lib/showcase"

const { user } = Astro.locals
const me = user?.member ?? null
const events = await upcomingEvents(6)
const count = me ? await countMembers() : null
const featured = events[0] ?? showcaseEvent()
const Featured = passDesign(featured.design)
const layers = [
  { name: "视频层", text: "最底下是一段循环视频，没有视频时是一团流动的渐变。", note: "the footage", plane: ".footage" },
  { name: "白色底板", text: "整张铺满的白纸，和下面一层用 screen 模式混合，白色依旧是白色。", note: "white sheet · screen", plane: ".sheet" },
  { name: "镂空大字", text: "黑色的字在 screen 混合下变成透明，视频就从字形里透出来。", note: "type punches through", plane: ".word" },
  { name: "印刷层", text: "名字、全息印章、时间地点和二维码，正常印在最上面。", note: "the print", plane: ".print" },
  { name: "光泽", text: "跟着指针移动的一层高光，让卡面看起来是一张真的卡。", note: "the glare", plane: ".glare" },
]
---

<Base title="NBTCA Cards">
  <main class="wrap">
    <section class="hero">
      <div class="copy">
        <p class="eyebrow reveal">Computer Association · NingboTech</p>
        <h1 class="title reveal" style="--i: 1">把每一次相遇<br />做成一张卡</h1>
        <p class="lede reveal" style="--i: 2">
          社员卡是你在计算机协会的身份，活动券记下你去过的每一场活动。移动鼠标，或者拿起手机晃一晃，它们会跟着你动。
        </p>
        <div class="actions reveal" style="--i: 3">
          {me
            ? <a class="button" href={`/members/${me.id}`}>看我的社员卡</a>
            : <a class="button" href={events.length ? `/e/${featured.slug}` : "/e"}>去领活动券</a>}
          {me
            ? <a class="button ghost" href="/members">全部 {count} 位社员</a>
            : !user && <a class="button ghost" href="/login?next=/members">社员登录</a>}
        </div>
      </div>

      <div class="fan">
        <div class="slot member"><MemberCard member={me ?? showcaseMember()} size="full" /></div>
        <div class="slot pass"><Featured event={featured} pass={null} holder={user?.name ?? "你的名字"} guest={!me} /></div>
        <div class="floor" />
      </div>
    </section>

    <section class="anatomy" data-anatomy-scroll>
      <div class="pin">
        <div class="explain">
          <p class="eyebrow">Anatomy</p>
          <h2>一张券的五层</h2>
          <ol>
            {layers.map((l, i) => (
              <li style={`--at: ${(i / layers.length).toFixed(2)}`}>
                <b><span>0{i + 1}</span>{l.name}</b>
                <p>{l.text}</p>
              </li>
            ))}
          </ol>
        </div>
        <div class="exploded" data-notes={JSON.stringify(layers.map((l) => l.plane))}>
          <Featured event={featured} pass={null} holder={user?.name ?? "你的名字"} guest={!me} anatomy />
          <svg class="leaders" aria-hidden="true">
            {layers.map(() => (
              <g>
                <path class="shaft" pathLength="1" />
                <path class="head" pathLength="1" />
              </g>
            ))}
          </svg>
          <ul class="notes" aria-hidden="true">
            {layers.map((l, i) => <li style={`--at: ${(i / layers.length).toFixed(2)}`}>{l.note}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="events">
      <header>
        <p class="eyebrow">Upcoming</p>
        <h2>近期活动</h2>
        <a class="more" href="/e">全部活动 →</a>
      </header>
      {events.length ? <EventList events={events} /> : <p class="muted">最近还没有活动，过几天再来看看。</p>}
    </section>
  </main>
</Base>

<script>
  import { scribble, whoosh } from "../lib/sound"

  const section = document.querySelector<HTMLElement>("[data-anatomy-scroll]")
  const pass = section?.querySelector<HTMLElement>("[data-anatomy]")
  if (section && pass) {
    let frame = 0
    const update = () => {
      frame = 0
      const { top, height } = section.getBoundingClientRect()
      const progress = Math.min(1, Math.max(0, -top / (height - innerHeight)))
      const e = Math.min(1, Math.max(0, (progress - 0.12) / 0.6))
      const eased = 1 - (1 - e) ** 3
      section.style.setProperty("--e", eased.toFixed(4))
      const open = eased > 0.5
      if (open !== wasOpen) {
        if (wasOpen !== null) whoosh(open)
        wasOpen = open
      }
      pass.toggleAttribute("data-exploded", eased > 0.04)
      if (eased > 0.04 && notes.length) place()
    }

    // Leader lines point at where each layer ends up after the 3D transform, so they are measured each frame.
    const box = section.querySelector<HTMLElement>("[data-notes]")!
    const planes = (JSON.parse(box.dataset.notes!) as string[]).map((s) => pass.querySelector<HTMLElement>(s)!)
    const shafts = [...box.querySelectorAll<SVGPathElement>(".leaders .shaft")]
    const heads = [...box.querySelectorAll<SVGPathElement>(".leaders .head")]
    const drawn = new Set<number>()
    // A slight wobble from the note's index keeps each stroke looking hand-drawn but stable between frames.
    const wobble = (i: number, k: number) => Math.sin(i * 12.9898 + k * 78.233) * 6
    const notes = matchMedia("(min-width: 1100px)").matches ? [...box.querySelectorAll<HTMLElement>(".notes li")] : []
    let wasOpen: boolean | null = null
    const place = () => {
      const origin = box.getBoundingClientRect()
      const rects = planes.map((p) => p.getBoundingClientRect())
      const edge = Math.min(...rects.map((r) => r.left)) - origin.left - 50
      const e = Number(section.style.getPropertyValue("--e"))
      // Bottom layer first, each label at least 34px above the one before so they never stack up.
      let floor = Infinity
      rects.forEach((r, i) => {
        const ax = r.left - origin.left + r.width * 0.1
        const ay = r.top - origin.top + r.height * 0.55
        const ly = Math.min(ay, floor - 34)
        floor = ly
        notes[i]!.style.translate = `${edge}px ${ly - 12}px`
        const sx = edge + 8
        const c1 = `${sx + 34 + wobble(i, 1)} ${ly - 14 + wobble(i, 2)}`
        const c2 = `${ax - 40 + wobble(i, 3)} ${ay + 18 + wobble(i, 4)}`
        shafts[i]!.setAttribute("d", `M${sx} ${ly} C${c1} ${c2} ${ax - 4} ${ay}`)
        const angle = Math.atan2(ay - (ay + 18 + wobble(i, 4)), ax - 4 - (ax - 40 + wobble(i, 3)))
        const wing = (d: number) => `${ax - 4 - 11 * Math.cos(angle + d)} ${ay - 11 * Math.sin(angle + d)}`
        heads[i]!.setAttribute("d", `M${wing(0.5)} L${ax - 4} ${ay} L${wing(-0.5)}`)
        const on = Math.min(1, Math.max(0, (e - (i / planes.length) * 0.9) * 6))
        shafts[i]!.style.strokeDashoffset = String(1 - Math.min(1, on * 1.25))
        heads[i]!.style.strokeDashoffset = String(1 - Math.max(0, on * 5 - 4))
        if (on > 0.3 && !drawn.has(i)) {
          drawn.add(i)
          scribble(0, 0.35)
        } else if (on === 0) drawn.delete(i)
      })
    }
    addEventListener("scroll", () => (frame ||= requestAnimationFrame(update)), { passive: true })
    update()
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
    min-height: min(820px, calc(100svh - 6rem));
    padding-block: 2rem 4rem;
  }

  .copy {
    display: grid;
    gap: 1.6rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .fan {
    position: relative;
    width: min(560px, 100%);
    aspect-ratio: 1;
    justify-self: center;
  }

  .slot {
    position: absolute;
    width: 50%;
    animation: float 7s ease-in-out infinite;
  }

  .slot.member {
    left: 2%;
    top: 6%;
    rotate: -10deg;
  }

  .slot.pass {
    right: 2%;
    top: 12%;
    rotate: 8deg;
    z-index: 1;
    animation-delay: -3.5s;
  }

  .slot :global(.card.full),
  .slot :global(.pass-card) {
    width: 100%;
    rotate: 0deg;
  }

  .floor {
    position: absolute;
    inset: auto 10% 0;
    height: 14%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(59 141 255 / 0.35), transparent);
    filter: blur(20px);
  }

  @keyframes float {
    50% {
      translate: 0 -14px;
    }
  }

  .anatomy {
    --e: 0;
    height: 260svh;
    margin-top: 4rem;
  }

  .pin {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 2rem;
    height: 100svh;
  }

  .explain {
    display: grid;
    gap: 1.25rem;
  }

  .explain h2 {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
  }

  .explain ol {
    display: grid;
    gap: 1.1rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .explain li {
    --on: clamp(0, (var(--e) - var(--at) * 0.9) * 6, 1);
    opacity: calc(0.25 + var(--on) * 0.75);
    translate: calc((1 - var(--on)) * -12px) 0;
  }

  .explain b {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 1.05rem;
  }

  .explain b span {
    font: 800 0.75rem / 1 var(--wide);
    font-stretch: 125%;
    color: var(--glow);
  }

  .explain li p {
    margin: 0.35rem 0 0 1.85rem;
    max-width: 22em;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--muted);
  }

  @font-face {
    font-family: "Caveat";
    src: url("/fonts/caveat-latin-600.woff2") format("woff2");
    font-weight: 600;
    font-display: swap;
  }

  .exploded {
    position: relative;
    display: grid;
    place-items: center;
  }

  .leaders {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .leaders path {
    fill: none;
    stroke: var(--note);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 1;
    opacity: 0.85;
  }

  .notes {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .notes li {
    --on: clamp(0, (var(--e) - var(--at) * 0.9) * 6, 1);
    position: absolute;
    top: 0;
    left: 0;
    font: 600 1.4rem / 1 "Caveat", cursive;
    color: var(--note);
    white-space: nowrap;
    opacity: var(--on);
    rotate: -3deg;
    transform: translateX(-100%);
  }

  @media (max-width: 1099px) {
    .leaders,
    .notes {
      display: none;
    }
  }

  .exploded :global(.pass-card) {
    width: min(320px, 70vw);
    margin-top: 12vh;
  }

  .events {
    display: grid;
    gap: 2.5rem;
    padding-top: 2rem;
  }

  .events header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 0.6rem 1rem;
  }

  .events h2 {
    grid-column: 1;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .more {
    grid-column: 2;
    grid-row: 2;
    text-decoration: none;
    color: var(--muted);
  }

  .more:hover {
    color: var(--fg);
  }

  @media (max-width: 860px) {
    .pin {
      grid-template-columns: 1fr;
      align-content: center;
    }

    .explain li p {
      display: none;
    }

    .exploded {
      order: -1;
    }

    .exploded :global(.pass-card) {
      width: min(190px, 48vw);
      margin-top: 12vh;
    }

    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-top: 3rem;
    }

    .fan {
      width: min(440px, 100%);
    }
  }
</style>
