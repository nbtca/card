---
import MemberCard from "../cards/MemberCard.astro"
import Base from "../layouts/Base.astro"
import { db, getMember, mediaUrl } from "../lib/db"

const id = Astro.locals.user!.member!.id
let saved = false

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()
  const text = (name: string, max: number) => String(form.get(name) ?? "").trim().slice(0, max) || null
  const hue = Math.round(Number(form.get("hue")))
  const year = Number(form.get("joined"))
  const thisYear = new Date().getFullYear()
  await db()
    .prepare("UPDATE members SET word = ?, motto = ?, hue = ?, section = ?, role = ?, joined = ?, github = ? WHERE id = ?")
    .bind(
      text("word", 12),
      text("motto", 40),
      Number.isFinite(hue) ? Math.min(360, Math.max(0, hue)) : 210,
      text("section", 12) ?? "",
      text("role", 12) ?? "社员",
      Number.isInteger(year) && year >= 2000 && year <= thisYear ? year : thisYear,
      text("github", 39)?.replace(/^@/, "") ?? null,
      id,
    )
    .run()
  saved = true
}

const member = (await getMember(id))!
const swatches = [212, 248, 280, 320, 350, 18, 42, 140, 172, 196]
const uploads = [
  { kind: "portrait", label: "人像", hint: "去掉背景的透明 PNG 效果最好，上传后可以拖动、缩放来摆位置。", key: member.portrait },
  { kind: "background", label: "背景", hint: "任意照片都行，上传后选择要显示的部分。", key: member.background },
]
---

<Base title="装扮我的卡片 · NBTCA">
  <main class="wrap" style={`--hue: ${member.hue}`}>
    <div class="stage">
      <MemberCard member={member} size="full" />
      <p class="hint">点击卡片看背面</p>
    </div>

    <div class="editor">
      <header class="reveal">
        <p class="eyebrow">Customize</p>
        <h1>装扮我的卡片</h1>
        <p class="muted">姓名和代号来自你的 Logto 账号，其他都由你决定。卡面上的改动会立刻出现在左边。</p>
      </header>

      {saved && <p class="notice reveal">已保存，所有人看到的都是新卡面了。</p>}

      <form class="panel form reveal" style="--i: 1" method="post">
        <label>
          卡面大字
          <input name="word" maxlength="12" value={member.word ?? ""} placeholder={member.alias} data-live="word" />
        </label>
        <label>
          个性签名
          <input name="motto" maxlength="40" value={member.motto ?? ""} placeholder="To be at the intersection of technology and liberal arts." data-live="motto" />
        </label>
        <div class="hues">
          <span>主色调</span>
          <div class="swatches">
            {swatches.map((h) => (
              <button type="button" class="swatch" style={`--h: ${h}`} data-hue={h} aria-label={`色相 ${h}`} aria-pressed={String(h === member.hue)} />
            ))}
          </div>
          <input name="hue" type="range" min="0" max="360" value={member.hue} data-live="hue" aria-label="自定义色相" />
        </div>
        <div class="pair">
          <label>部门<input name="section" maxlength="12" value={member.section} placeholder="技术部" data-live="section" /></label>
          <label>身份<input name="role" maxlength="12" value={member.role} placeholder="社员" data-live="role" /></label>
          <label>入会年份<input name="joined" type="number" min="2000" max={new Date().getFullYear()} value={member.joined} /></label>
          <label>GitHub<input name="github" maxlength="39" value={member.github ?? ""} placeholder="用户名" /></label>
        </div>
        <button class="button">保存</button>
      </form>

      <section class="panel uploads reveal" style="--i: 2">
        {uploads.map(({ kind, label, hint, key }) => (
          <div class="upload">
            <div class="thumb" style={key ? `background-image: url(${mediaUrl(key, "thumb")})` : undefined} data-kind={kind} />
            <div class="text">
              <strong>{label}</strong>
              <span>{hint}</span>
              <div class="row">
                <label class="button ghost">
                  {key ? "更换" : "上传"}
                  <input type="file" accept="image/png,image/webp,image/jpeg" data-upload={kind} hidden />
                </label>
                {key && <button class="button ghost" type="button" data-remove={kind}>移除</button>}
              </div>
            </div>
          </div>
        ))}
        <p class="notice" data-status hidden />
      </section>
    </div>

    <dialog class="cropper panel" data-cropper aria-labelledby="crop-title">
      <h2 id="crop-title" data-crop-title>调整画面</h2>
      <p class="muted">拖动照片选择要显示的部分，滚轮或双指可以缩放。框里的画面就是卡片上会显示的样子。</p>
      <div class="frame" data-frame tabindex="0" aria-label="拖动调整画面，方向键移动，加减号缩放">
        <img alt="" draggable="false" data-crop-img />
        <span class="guides" aria-hidden="true" />
      </div>
      <label class="zoom">
        缩放
        <input type="range" min="0" max="1" step="0.001" value="0" data-zoom />
      </label>
      <div class="actions">
        <button class="button" type="button" data-crop-save>使用这张</button>
        <button class="button ghost" type="button" data-crop-reset>重新居中</button>
        <button class="button ghost" type="button" data-crop-cancel>取消</button>
      </div>
    </dialog>
  </main>
</Base>

<script>
  import { Cropper } from "../lib/crop"

  const card = document.querySelector<HTMLElement>("[data-card]")!
  const main = document.querySelector<HTMLElement>("main")!
  const status = document.querySelector<HTMLElement>("[data-status]")!
  const show = (text: string) => {
    status.textContent = text
    status.hidden = false
  }

  const hue = document.querySelector<HTMLInputElement>("[data-live=hue]")!
  const setHue = (value: string) => {
    hue.value = value
    card.style.setProperty("--hue", value)
    main.style.setProperty("--hue", value)
    document.querySelectorAll<HTMLElement>("[data-hue]").forEach((s) => s.setAttribute("aria-pressed", String(s.dataset.hue === value)))
  }
  hue.addEventListener("input", () => setHue(hue.value))
  document.querySelectorAll<HTMLElement>("[data-hue]").forEach((s) => s.addEventListener("click", () => setHue(s.dataset.hue!)))

  const word = card.querySelector<HTMLElement>("[data-fit]")!
  const motto = card.querySelector<HTMLElement>(".motto")
  const live = (name: string, apply: (value: string) => void) => {
    const input = document.querySelector<HTMLInputElement>(`[data-live=${name}]`)!
    input.addEventListener("input", () => apply(input.value.trim() || input.placeholder))
  }
  live("word", (value) => {
    word.textContent = value
    dispatchEvent(new Event("card:refit"))
  })
  if (motto) live("motto", (value) => (motto.textContent = value))
  const sub = card.querySelector<HTMLElement>(".sub")!
  const section = document.querySelector<HTMLInputElement>("[data-live=section]")!
  const role = document.querySelector<HTMLInputElement>("[data-live=role]")!
  const updateSub = () => (sub.textContent = [section.value.trim(), role.value.trim() || "社员"].filter(Boolean).join(" · "))
  section.addEventListener("input", updateSub)
  role.addEventListener("input", updateSub)

  const dialog = document.querySelector<HTMLDialogElement>("[data-cropper]")!
  const frame = dialog.querySelector<HTMLElement>("[data-frame]")!
  const cropImg = dialog.querySelector<HTMLImageElement>("[data-crop-img]")!
  const zoom = dialog.querySelector<HTMLInputElement>("[data-zoom]")!
  let cropper: Cropper | null = null
  let kind = ""
  let previewUrl = ""
  // The card's own layers are swapped for the cropped result so the preview is exactly what will be saved.
  const originals = new Map<Element, string>()

  const layer = (name: string) => card.querySelector<HTMLElement>(`.front > .layer.${name === "portrait" ? "subject" : "sky"}`)!
  const showOnCard = (url: string) => {
    const target = layer(kind)
    if (!originals.has(target)) originals.set(target, target.innerHTML)
    target.innerHTML = `<img src="${url}" alt="" style="width:100%;height:100%;object-fit:cover${kind === "portrait" ? ";scale:1.08;object-position:50% 100%" : ""}">`
  }
  const restoreCard = () => {
    originals.forEach((html, el) => (el.innerHTML = html))
    originals.clear()
  }

  // One render at a time; a change that lands mid-render queues one more so the card ends on the latest framing.
  let rendering = false
  let again = false
  const preview = async () => {
    if (!cropper) return
    if (rendering) return void (again = true)
    rendering = true
    const blob = await cropper.render(400)
    rendering = false
    URL.revokeObjectURL(previewUrl)
    previewUrl = URL.createObjectURL(blob)
    showOnCard(previewUrl)
    if (again) {
      again = false
      preview()
    }
  }

  const discard = () => {
    cropper?.destroy()
    cropper = null
    URL.revokeObjectURL(cropImg.src)
  }

  const close = () => {
    dialog.close()
    discard()
  }

  for (const input of document.querySelectorAll<HTMLInputElement>("[data-upload]")) {
    input.addEventListener("change", async () => {
      const file = input.files?.[0]
      input.value = ""
      if (!file) return
      try {
        const bitmap = await createImageBitmap(file)
        kind = input.dataset.upload!
        dialog.dataset.kind = kind
        dialog.querySelector("[data-crop-title]")!.textContent = kind === "portrait" ? "调整人像" : "调整背景"
        discard()
        cropImg.src = URL.createObjectURL(file)
        dialog.showModal()
        cropper = new Cropper(frame, cropImg, bitmap, kind === "background", (settled) => {
          zoom.value = String(cropper?.zoom ?? 0)
          if (settled) preview()
        })
        frame.focus()
      } catch {
        show("这张图片打不开，换一张试试。")
      }
    })
  }

  zoom.addEventListener("input", () => cropper?.setZoom(Number(zoom.value), false))
  zoom.addEventListener("change", () => preview())
  dialog.querySelector("[data-crop-reset]")!.addEventListener("click", () => cropper?.reset())
  dialog.querySelector("[data-crop-cancel]")!.addEventListener("click", () => {
    restoreCard()
    close()
  })
  dialog.addEventListener("cancel", () => {
    restoreCard()
    discard()
  })
  dialog.querySelector("[data-crop-save]")!.addEventListener("click", async () => {
    if (!cropper) return
    const saving = cropper
    cropper = null
    dialog.close()
    URL.revokeObjectURL(cropImg.src)
    show("正在上传…")
    try {
      const body = new FormData()
      body.set("full", await saving.render(1000))
      body.set("thumb", await saving.render(400))
      saving.destroy()
      const response = await fetch(`/api/me/media?kind=${kind}`, { method: "PUT", body })
      if (!response.ok) throw new Error(await response.text())
      location.reload()
    } catch (error) {
      restoreCard()
      show(`上传失败，${error instanceof Error ? error.message : error}`)
    }
  })

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-remove]")) {
    button.addEventListener("click", async () => {
      const response = await fetch(`/api/me/media?kind=${button.dataset.remove}`, { method: "DELETE" })
      if (response.ok) location.reload()
      else show("移除失败，请稍后再试。")
    })
  }
</script>

<style>
  .cropper {
    width: min(26rem, calc(100vw - 32px));
    max-height: calc(100svh - 32px);
    margin: auto;
    padding: 1.5rem;
    color: var(--fg);
    background: var(--bg);
    overflow: auto;
  }

  /* No blur: the card on the left is the live preview and must stay visible. */
  .cropper::backdrop {
    background: linear-gradient(90deg, transparent 45%, rgb(0 0 0 / 0.45));
  }

  @media (min-width: 900px) {
    .cropper {
      margin-right: max(16px, (100vw - 1160px) / 2);
    }
  }

  @media (max-width: 899px) {
    .cropper::backdrop {
      background: rgb(0 0 0 / 0.5);
    }
  }

  .cropper[open] {
    display: grid;
    gap: 1rem;
  }

  .cropper h2 {
    font-size: 1.3rem;
  }

  .cropper p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .frame {
    position: relative;
    width: min(100%, (100svh - 22rem) * 5 / 7);
    justify-self: center;
    aspect-ratio: 5 / 7;
    overflow: hidden;
    border-radius: 1rem;
    background: rgb(var(--tint) / 0.06);
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .frame:active {
    cursor: grabbing;
  }

  .frame:focus-visible {
    outline: 2px solid var(--glow);
    outline-offset: 3px;
  }

  /* A cut-out portrait shows its transparency on a checkerboard. */
  [data-kind="portrait"] .frame {
    background: repeating-conic-gradient(rgb(var(--tint) / 0.08) 0 25%, transparent 0 50%) 0 0 / 18px 18px;
  }

  .frame img {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
    transform-origin: 0 0;
    pointer-events: none;
    will-change: transform;
  }

  .guides {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent calc(33.33% - 0.5px), rgb(255 255 255 / 0.35) 0 calc(33.33% + 0.5px), transparent 0 calc(66.66% - 0.5px), rgb(255 255 255 / 0.35) 0 calc(66.66% + 0.5px), transparent 0),
      linear-gradient(transparent calc(33.33% - 0.5px), rgb(255 255 255 / 0.35) 0 calc(33.33% + 0.5px), transparent 0 calc(66.66% - 0.5px), rgb(255 255 255 / 0.35) 0 calc(66.66% + 0.5px), transparent 0);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.25) inset;
  }

  .zoom input {
    width: 100%;
    accent-color: var(--glow);
    background: none;
    appearance: auto;
    height: auto;
  }

  .zoom {
    display: grid;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .actions {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 0.6rem;
  }

  .actions .button {
    padding-inline: 1.1rem;
  }

  main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: 3rem 4rem;
    padding-block: 3rem;
  }

  .stage {
    position: sticky;
    top: 7rem;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }

  .stage::before {
    content: "";
    position: absolute;
    inset: 5% 0 10%;
    z-index: -1;
    background: radial-gradient(closest-side, oklch(0.6 0.16 var(--hue) / 0.35), transparent);
    filter: blur(30px);
    transition: background 0.4s;
  }

  .hint {
    margin: 0;
    font-size: 0.82rem;
    color: var(--faint);
  }

  .editor {
    display: grid;
    gap: 1.5rem;
  }

  header {
    display: grid;
    gap: 0.8rem;
  }

  header h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  header p {
    margin: 0;
    line-height: 1.7;
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .hues {
    display: grid;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .swatch {
    width: 2.1rem;
    aspect-ratio: 1;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 50%;
    background: linear-gradient(135deg, oklch(0.72 0.15 var(--h)), oklch(0.42 0.16 calc(var(--h) + 30)));
    cursor: pointer;
    transition: scale 0.2s var(--ease);
  }

  .swatch:hover {
    scale: 1.1;
  }

  .swatch[aria-pressed="true"] {
    border-color: var(--fg);
    box-shadow: 0 0 0 3px rgb(var(--tint) / 0.15);
  }

  input[type="range"][data-live] {
    width: 100%;
    height: 0.6rem;
    border-radius: 99px;
    appearance: none;
    background: linear-gradient(90deg in oklch longer hue, oklch(0.7 0.15 0), oklch(0.7 0.15 360));
  }

  input[type="range"][data-live]::-webkit-slider-thumb {
    width: 1.3rem;
    aspect-ratio: 1;
    border: 3px solid #fff;
    border-radius: 50%;
    appearance: none;
    background: oklch(0.65 0.16 var(--hue));
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.5);
  }

  .uploads {
    display: grid;
    gap: 1.25rem;
  }

  .upload {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1.1rem;
    align-items: center;
  }

  .thumb {
    aspect-ratio: 5 / 7;
    border: 1px dashed var(--line);
    border-radius: 0.8rem;
    background: rgb(var(--tint) / 0.03) center / cover no-repeat;
  }

  .thumb[data-kind="portrait"] {
    background-size: contain;
    background-position: center bottom;
  }

  .text {
    display: grid;
    gap: 0.35rem;
  }

  .text span {
    font-size: 0.82rem;
    color: var(--faint);
  }

  .row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .row .button {
    min-height: 2.3rem;
    padding-inline: 1rem;
    font-size: 0.85rem;
  }

  @media (max-width: 860px) {
    main {
      grid-template-columns: 1fr;
    }

    .stage {
      position: static;
    }
  }
</style>
