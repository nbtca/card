---
import EventList from "../../components/EventList.astro"
import PassShelf from "../../components/PassShelf.astro"
import Base from "../../layouts/Base.astro"
import { checkInPhase, passesOf, upcomingEvents } from "../../lib/db"

const { user } = Astro.locals
const [events, passes] = await Promise.all([upcomingEvents(), user ? passesOf(user.email) : []])
const mine = passes.filter((p) => !p.redeemed_at && checkInPhase(p) !== "ended")
---

<Base title="活动 · NBTCA">
  <main class="wrap">
    <header>
      <p class="eyebrow reveal">Events</p>
      <h1 class="title reveal" style="--i: 1">活动</h1>
      <p class="lede reveal" style="--i: 2">每场活动一张券，当天凭券入场。</p>
      {user && (
        <div class="actions reveal" style="--i: 3">
          {user.member && <a class="button" href="/e/new">发起活动</a>}
          {passes.some((p) => p.redeemed_at) && <a class="button ghost" href="/recap">年度回顾</a>}
        </div>
      )}
    </header>
    {mine.length > 0 && <PassShelf stubs={mine} guest={!user?.member} eyebrow="Your passes" title="我的券" lede="到场后撕开贴纸扫码。" named={false} />}
    {events.length ? <EventList events={events} /> : <p class="muted">近期没有活动。</p>}
  </main>
</Base>

<style>
  main {
    display: grid;
    gap: 4rem;
    padding-block: 4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  header {
    display: grid;
    justify-items: start;
    gap: 1.2rem;
  }
</style>
