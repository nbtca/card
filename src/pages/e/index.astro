---
import EventList from "../../components/EventList.astro"
import Base from "../../layouts/Base.astro"
import { upcomingEvents } from "../../lib/db"

const events = await upcomingEvents()
---

<Base title="活动 · NBTCA">
  <main>
    <h1>活动</h1>
    {events.length ? <EventList events={events} /> : <p class="muted">最近没有活动。</p>}
  </main>
</Base>

<style>
  main {
    max-width: 1080px;
    margin: 0 auto;
    padding-block: 6vh 10vh;
    display: grid;
    gap: 2rem;
  }
</style>
