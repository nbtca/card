---
import EventEditor from "../../../components/EventEditor.astro"
import Base from "../../../layouts/Base.astro"
import { db, getEvent, type Pass } from "../../../lib/db"
import { formatShort, padSerial } from "../../../lib/format"
import { maskPhone } from "../../../lib/attendee"
import { purgePages } from "../../../lib/cache"
import { canEdit, saveEvent } from "../../../lib/events"

const { user } = Astro.locals
if (!user) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`)
const [event, { results: passes }] = await Promise.all([
  getEvent(Astro.params.slug!),
  db().prepare("SELECT * FROM passes WHERE event = ? ORDER BY serial").bind(Astro.params.slug).all<Pass>(),
])
if (!event) return new Response(null, { status: 404 })
if (!canEdit(event, user)) return Astro.redirect(`/e/${event.slug}`)

let error = ""
if (Astro.request.method === "POST") {
  const result = await saveEvent(await Astro.request.formData(), event, event.created_by)
  if (result.slug) {
    purgePages(Astro.url, ["/", "/e", `/e/${event.slug}`])
    return Astro.redirect(`/e/${event.slug}`, 303)
  }
  error = result.error
}

const entered = passes.filter((p) => p.redeemed_at).length
const stamp = (ms: number) => formatShort(new Date(ms).toISOString())
---

<Base title={`编辑 ${event.title} · NBTCA`}>
  <main class="wrap">
    <header>
      <p class="eyebrow reveal">Edit event</p>
      <h1 class="title reveal" style="--i: 1">{event.title}</h1>
    </header>

    <EventEditor event={event} isNew={false} error={error} holder={user.name} />

    <section class="panel roll reveal">
      <div class="head">
        <h2>领取名单</h2>
        <dl>
          <div><dt>已领取</dt><dd>{passes.length}{event.capacity !== null && <small> / {event.capacity}</small>}</dd></div>
          <div><dt>已入场</dt><dd>{entered}</dd></div>
        </dl>
        {passes.length > 0 && (
          <div class="exports">
            <a class="button ghost" href={`/e/${event.slug}/live`} target="_blank">打开入场大屏</a>
            <a class="button" href={`/e/${event.slug}/attendees.csv?only=entered`} download>导出已入场名单</a>
            <a class="button ghost" href={`/e/${event.slug}/attendees.csv`} download>导出全部名单</a>
          </div>
        )}
      </div>
      {event.needs_info === 1 && <p class="muted privacy">名单含学号和手机号，仅用于学分申报，请勿外传。</p>}
      {passes.length
        ? (
            <table>
              <thead>
                <tr>
                  <th>编号</th><th>姓名</th>
                  {event.needs_info === 1 && <><th>学号</th><th>班级</th><th>手机号</th></>}
                  <th>领取时间</th><th>入场时间</th>
                </tr>
              </thead>
              <tbody>
                {passes.map((p) => (
                  <tr>
                    <td>{padSerial(p.serial)}</td>
                    <td>{p.name}</td>
                    {event.needs_info === 1 && (
                      <>
                        <td>{p.student_id ?? "—"}</td>
                        <td>{p.class_name ?? "—"}</td>
                        <td>{p.phone ? maskPhone(p.phone) : "—"}</td>
                      </>
                    )}
                    <td>{stamp(p.created_at)}</td>
                    <td>{p.redeemed_at ? stamp(p.redeemed_at) : <span class="muted">未入场</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        : <p class="muted">还没有人领券。</p>}
    </section>
  </main>
</Base>

<style>
  main {
    display: grid;
    gap: 3.5rem;
    padding-block: 3rem;
  }

  header {
    display: grid;
    gap: 1.2rem;
  }

  .roll {
    display: grid;
    gap: 1.5rem;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  dl {
    display: flex;
    gap: 2.5rem;
    margin: 0;
  }

  dt {
    font-size: 0.8rem;
    color: var(--faint);
  }

  dd {
    margin: 0.3rem 0 0;
    font: 800 2rem / 1 var(--wide);
    font-stretch: 125%;
  }

  .exports {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .privacy {
    margin: 0;
    font-size: 0.85rem;
  }

  dd small {
    font-size: 1rem;
    color: var(--faint);
  }
</style>
