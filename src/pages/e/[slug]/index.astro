---
import Lanyard from "../../../cards/Lanyard.astro"
import { passDesign } from "../../../cards/pass"
import Base from "../../../layouts/Base.astro"
import { checkInOpensAt, checkInPhase, claimPhase, db, formatClock, formatRange, formatShort, formatTime, getEvent, randomId, sameDay, ZONE, type Member, type Pass } from "../../../lib/db"
import { parseAttendee } from "../../../lib/attendee"
import { purgePages } from "../../../lib/cache"
import { canEdit } from "../../../lib/events"

const { slug } = Astro.params
const { user } = Astro.locals

const findPass = () =>
  user ? db().prepare("SELECT * FROM passes WHERE event = ? AND email = ?").bind(slug, user.email).first<Pass>() : null

// Prefilled from the visitor's last registration so returning students do not type it all again.
const findPrevious = () =>
  user
    ? db()
        .prepare("SELECT name, student_id, class_name, phone FROM passes WHERE email = ? AND student_id IS NOT NULL ORDER BY created_at DESC LIMIT 1")
        .bind(user.email)
        .first<{ name: string; student_id: string; class_name: string; phone: string }>()
    : null

// D1 sits in one region and every query is a round trip, so the page asks everything at once.
const [event, pass, previous, counted, host] = await Promise.all([
  getEvent(slug!),
  findPass(),
  findPrevious(),
  db().prepare("SELECT COUNT(*) AS n FROM passes WHERE event = ?").bind(slug).first<{ n: number }>(),
  db().prepare("SELECT * FROM members WHERE email = (SELECT created_by FROM events WHERE slug = ?)").bind(slug).first<Member>(),
])
if (!event) return new Response(null, { status: 404 })

let form = { name: previous?.name ?? user?.name ?? "", studentId: previous?.student_id ?? "", className: previous?.class_name ?? "", phone: previous?.phone ?? "" }
let claimError = ""

if (Astro.request.method === "POST") {
  if (!user) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`)
  const data = await Astro.request.formData()
  const attendee = event.needs_info ? parseAttendee(data) : null
  if (typeof attendee === "string") {
    claimError = attendee
    form = {
      name: String(data.get("name") ?? ""),
      studentId: String(data.get("student_id") ?? ""),
      className: String(data.get("class_name") ?? ""),
      phone: String(data.get("phone") ?? ""),
    }
  } else {
    const name = attendee?.name ?? user.member?.name ?? (String(data.get("name") ?? "").trim().slice(0, 20) || user.name)
    try {
      await db()
        .prepare(
          `INSERT INTO passes (id, event, email, name, serial, created_at, student_id, class_name, phone)
           SELECT ?1, slug, ?3, ?4, COALESCE((SELECT MAX(serial) FROM passes WHERE event = ?2), 0) + 1, ?5, ?7, ?8, ?9
           FROM events
           WHERE slug = ?2 AND claim_from <= ?6 AND claim_until >= ?6
             AND (capacity IS NULL OR (SELECT COUNT(*) FROM passes WHERE event = ?2) < capacity)
           ON CONFLICT (event, email) DO NOTHING`,
        )
        .bind(randomId(), event.slug, user.email, name, Date.now(), new Date().toISOString(), attendee?.studentId ?? null, attendee?.className ?? null, attendee?.phone ?? null)
        .run()
    } catch (e) {
      if (!String(e).includes("UNIQUE")) throw e
      claimError = "这个学号已经领过这场活动的券了。如果不是你本人领的，请联系活动发起人。"
    }
    if (await findPass()) {
      purgePages(Astro.url, [Astro.url.pathname])
      return Astro.redirect(`${Astro.url.pathname}?issued`, 303)
    }
  }
}

const claimed = counted!.n
const full = event.capacity !== null && claimed >= event.capacity
const phase = claimPhase(event)
const passNotice = pass?.redeemed_at
  ? `你已经在 ${formatTime(new Date(pass.redeemed_at).toISOString())} 入场。`
  : checkInPhase(event) === "ended"
    ? "活动已经结束了。"
    : checkInPhase(event) === "open"
      ? "到场后把票根上的贴纸撕开，露出入场码给工作人员扫。扫过之后票根会被撕下，就算入场了。"
      : `入场码藏在票根的贴纸下面，${formatTime(checkInOpensAt(event))} 起才能撕开。`
const Design = passDesign(event.design)
const editable = canEdit(event, user)

const now = Date.now()
const milestones = [
  { at: event.claim_from, label: "开放领取" },
  { at: event.claim_until, label: "停止领取" },
  { at: event.starts_at, label: "活动开始" },
  { at: event.ends_at, label: "活动结束" },
].map((m) => ({ ...m, done: Date.parse(m.at) <= now }))
const next = milestones.find((m) => !m.done)
const start = new Date(event.starts_at)
const local = (options: Intl.DateTimeFormatOptions) => start.toLocaleString("en-US", { timeZone: ZONE, ...options })
const chip = {
  upcoming: { tone: "warn", text: "即将开放领取" },
  open: { tone: "ok", text: full ? "名额已满" : "正在领取" },
  closed: { tone: "", text: "领取已截止" },
}[phase]
---

<Base title={`${event.title} · NBTCA`} description={event.summary || `${formatRange(event.starts_at, event.ends_at)}，${event.venue}`}>
  <main class="wrap">
    <div class="stage">
      <Lanyard drop={Astro.url.searchParams.has("issued")}>
        <Design event={event} pass={pass} holder={pass?.name ?? user?.name ?? "你的名字"} guest={!user?.member} transitionName={`pass-${event.slug}`} />
      </Lanyard>
      <div class="spot" />
    </div>

    <section class="info">
      <span class="chip reveal" data-tone={pass ? "ok" : chip.tone}>{pass ? "已领取" : chip.text}</span>
      <h1 class="reveal" style="--i: 1">{event.title}</h1>

      <div class="when reveal" style="--i: 2">
        <span class="day">{local({ month: "2-digit" })}.{local({ day: "2-digit" })}</span>
        <span class="meta">
          <b>{local({ weekday: "long" })}</b>
          <span>
            {sameDay(event.starts_at, event.ends_at)
              ? `${formatClock(event.starts_at)}–${formatClock(event.ends_at)}`
              : `${formatClock(event.starts_at)} 开始，${formatTime(event.ends_at)} 结束`}
          </span>
          <span>{event.venue}</span>
        </span>
      </div>

      {event.summary && <p class="summary reveal" style="--i: 3">{event.summary}</p>}
      {(host || editable) && (
        <div class="host reveal" style="--i: 3">
          {host && <a href={`/members/${host.id}`} class="by"><span class="avatar" style={`--hue: ${host.hue}`}>{[...host.name][0]}</span>由 {host.name} 发起</a>}
          {editable && <a class="button ghost small" href={`/e/${event.slug}/edit`}>编辑活动与名单</a>}
        </div>
      )}

      <ol class="timeline reveal" style="--i: 4">
        {milestones.map((m) => (
          <li data-done={m.done ? "" : undefined} data-next={m === next ? "" : undefined}>
            <span class="dot" />
            <b>{m.label}</b>
            <span>{formatShort(m.at)}</span>
          </li>
        ))}
      </ol>

      {next && (
        <p class="countdown reveal" style="--i: 5" data-target={next.at}>
          距{next.label}还有 <span data-left>…</span>
        </p>
      )}

      <div class="act reveal" style="--i: 6">
        {pass
          ? (
              <>
                <p class="notice" data-pass-notice>{passNotice}</p>
                {!pass.redeemed_at && checkInPhase(event) !== "ended" && (
                  <a class="button ghost small" href={`/e/${event.slug}/calendar.ics`}>加入日历，开场前半小时提醒我</a>
                )}
              </>
            )
          : phase === "upcoming"
            ? <p class="notice">{formatTime(event.claim_from)} 开放领取，到时再来吧。</p>
            : phase === "closed"
              ? <p class="notice">领取已经在 {formatTime(event.claim_until)} 截止。</p>
              : full
                ? <p class="notice">名额已经领完了。</p>
                : user
                  ? (
                      <form class="form claim" method="post">
                        {claimError && <p class="notice error">{claimError}</p>}
                        {event.needs_info
                          ? (
                              <fieldset class="info">
                                <legend>学分登记</legend>
                                <p>这场活动可以申报学分，请如实填写。信息只给活动发起人用于申报。</p>
                                <label>姓名<input name="name" required maxlength="20" autocomplete="name" value={form.name} /></label>
                                <label>学号<input name="student_id" required inputmode="numeric" pattern="[23][0-9]{9}" maxlength="10" value={form.studentId} data-student-id /><small data-student-hint /></label>
                                <label>班级<input name="class_name" required minlength="2" maxlength="20" placeholder="计算机 2101" value={form.className} /></label>
                                <label>手机号<input name="phone" required type="tel" inputmode="numeric" pattern="1[3-9][0-9]{9}" maxlength="11" autocomplete="tel" value={form.phone} /></label>
                              </fieldset>
                            )
                          : !user.member && <label>印在券上的名字<input name="name" maxlength="20" required value={user.name} /></label>}
                        <button class="button">领取活动券</button>
                      </form>
                    )
                  : <a class="button" href={`/login?next=${encodeURIComponent(Astro.url.pathname)}`}>登录后领取活动券</a>}
        {event.capacity !== null && (
          <div class="meter" style={`--fill: ${Math.min(1, claimed / event.capacity)}`}>
            <span />
            <small>已领取 {claimed} / {event.capacity}</small>
          </div>
        )}
      </div>
    </section>
  </main>
</Base>

<script>
  import { checkStudentId, describeStudentId } from "../../../lib/attendee"

  const idInput = document.querySelector<HTMLInputElement>("[data-student-id]")
  const idHint = document.querySelector<HTMLElement>("[data-student-hint]")
  if (idInput && idHint) {
    const check = () => {
      const id = idInput.value.replace(/\s/g, "")
      const error = id.length === 10 ? checkStudentId(id) : null
      idInput.setCustomValidity(error ?? "")
      idHint.textContent = error ?? (id.length === 10 ? describeStudentId(id) : "")
      if (error) idHint.dataset.bad = ""
      else delete idHint.dataset.bad
    }
    idInput.addEventListener("input", check)
    check()
  }
  const el = document.querySelector<HTMLElement>("[data-target]")
  if (el) {
    const left = el.querySelector("[data-left]")!
    const target = Date.parse(el.dataset.target!)
    const pad = (n: number) => String(n).padStart(2, "0")
    const tick = () => {
      const s = Math.max(0, Math.floor((target - Date.now()) / 1000))
      const d = Math.floor(s / 86400)
      left.textContent = `${d ? `${d} 天 ` : ""}${pad(Math.floor(s / 3600) % 24)}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`
      // Signed-out visitors get a shared copy up to a minute old, so the refresh asks past it.
      if (s === 0) location.replace(`${location.pathname}?fresh`)
    }
    tick()
    setInterval(tick, 1000)
  }
  if (location.search) history.replaceState(null, "", location.pathname)

  const notice = document.querySelector<HTMLElement>("[data-pass-notice]")
  const say = (text: string) => {
    if (!notice) return
    notice.textContent = text
    notice.animate([{ opacity: 0.4 }, { opacity: 1 }], { duration: 300 })
  }
  addEventListener("pass:locked", () => notice?.animate([{ scale: 1 }, { scale: 1.03 }, { scale: 1 }], { duration: 300 }))
  addEventListener("pass:redeemed", (e) => {
    const at = new Date((e as CustomEvent<{ at: number }>).detail.at)
    say(`已核销，${at.toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" })} 入场。玩得开心！`)
  })
</script>

<style>
  main {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: 3rem 5rem;
    min-height: calc(100svh - 8rem);
    padding-block: 2rem 4rem;
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: 2rem;
  }

  .spot {
    position: absolute;
    inset: 10% 5% -5%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(59 141 255 / 0.28), transparent);
    filter: blur(30px);
  }

  .info {
    display: grid;
    justify-items: start;
    gap: 1.6rem;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.05;
  }

  .when {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .day {
    font: 800 clamp(3.2rem, 7vw, 5rem) / 0.85 var(--wide);
    font-stretch: 125%;
    letter-spacing: -0.03em;
    background: linear-gradient(120deg, var(--fg) 30%, var(--glow));
    background-clip: text;
    color: transparent;
  }

  .meta {
    display: grid;
    gap: 0.3rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--muted);
  }

  .meta b {
    font: 700 0.78rem / 1 var(--wide);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .summary {
    margin: 0;
    max-width: 32em;
    line-height: 1.8;
    color: var(--muted);
  }

  .host {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .by {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 1.8rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(135deg, oklch(0.7 0.16 var(--hue)), oklch(0.45 0.16 calc(var(--hue) + 40)));
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--fg);
  }

  .button.small {
    min-height: 2.3rem;
    padding-inline: 1rem;
    font-size: 0.85rem;
  }

  .timeline {
    --dot: 0.7rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    position: relative;
    display: grid;
    gap: 0.35rem;
    padding-top: 1.5rem;
    font-size: 0.78rem;
    color: var(--faint);
  }

  .timeline li::before {
    content: "";
    position: absolute;
    top: calc(var(--dot) / 2 - 1px);
    left: 0;
    right: 0;
    height: 2px;
    background: var(--line);
  }

  .timeline li[data-done]::before {
    background: var(--glow);
  }

  .timeline .dot {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: var(--dot);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line);
  }

  .timeline li[data-done] .dot {
    background: var(--glow);
    border-color: var(--glow);
  }

  .timeline li[data-next] .dot {
    border-color: var(--glow);
    box-shadow: 0 0 0 5px rgb(59 141 255 / 0.2);
  }

  .timeline b {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .timeline li:is([data-done], [data-next]) b {
    color: var(--fg);
  }

  .countdown {
    margin: 0;
    color: var(--muted);
  }

  .countdown span {
    font: 700 1.05rem / 1 var(--wide);
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .act {
    display: grid;
    gap: 1rem;
    width: 100%;
    max-width: 26rem;
  }

  .info {
    width: 100%;
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }

  .info small:empty {
    display: none;
  }

  .info small[data-bad] {
    color: #ffb4a3;
  }

  .claim {
    justify-items: start;
  }

  .meter {
    display: grid;
    gap: 0.5rem;
  }

  .meter span {
    height: 4px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--glow) calc(var(--fill) * 100%), var(--line) 0);
  }

  .meter small {
    font-size: 0.8rem;
    color: var(--faint);
  }

  @media (max-width: 900px) {
    main {
      grid-template-columns: 1fr;
    }

    .stage :global(.pass-card) {
      width: min(300px, 80vw);
    }

    .timeline {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1.25rem;
    }
  }
</style>
