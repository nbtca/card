---
import Lanyard from "../../../cards/Lanyard.astro"
import { passDesign, qrCode } from "../../../cards/pass"
import RepairTally from "../../../components/RepairTally.astro"
import SharePoster from "../../../components/SharePoster.astro"
import Timeline from "../../../components/Timeline.astro"
import Base from "../../../layouts/Base.astro"
import { checkInOpensAt, checkInPhase, claimPhase, db, getEvent, hostsOf, mediaUrl, randomId, type Pass } from "../../../lib/db"
import { formatClock, formatDay, formatRange, formatTime, sameDay, ZONE } from "../../../lib/format"
import { parseAttendee } from "../../../lib/attendee"
import { purgePages } from "../../../lib/cache"
import { canEdit } from "../../../lib/events"
import { meetCode, metAt } from "../../../lib/meets"

const { slug } = Astro.params
const { user } = Astro.locals

const findPass = () =>
  user ? db().prepare("SELECT * FROM passes WHERE event = ? AND email = ?").bind(slug, user.email).first<Pass>() : null

const findPrevious = () =>
  user
    ? db()
        .prepare("SELECT name, student_id, class_name, phone FROM passes WHERE email = ? AND student_id IS NOT NULL ORDER BY created_at DESC LIMIT 1")
        .bind(user.email)
        .first<{ name: string; student_id: string; class_name: string; phone: string }>()
    : null

// D1 sits in one region and every query is a round trip, so the page asks everything at once.
const [event, pass, previous, counted, hosts] = await Promise.all([
  getEvent(slug!),
  findPass(),
  findPrevious(),
  db().prepare("SELECT COUNT(*) AS n FROM passes WHERE event = ?").bind(slug).first<{ n: number }>(),
  hostsOf(slug!),
])
if (!event) return new Response(null, { status: 404 })

let form = { name: previous?.name ?? user?.name ?? "", studentId: previous?.student_id ?? "", className: previous?.class_name ?? "", phone: previous?.phone ?? "" }
let claimError = ""

if (Astro.request.method === "POST") {
  if (!user) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`)
  if (hosts.some((h) => h.email === user.email)) return Astro.redirect(Astro.url.pathname, 303)
  const data = await Astro.request.formData()
  const attendee = event.needs_info ? parseAttendee(data) : null
  if (typeof attendee === "string") {
    claimError = attendee
    form = {
      name: String(data.get("name") ?? ""),
      studentId: String(data.get("student_id") ?? ""),
      className: String(data.get("class_name") ?? ""),
      phone: String(data.get("phone") ?? ""),
    }
  } else {
    const name = attendee?.name ?? user.member?.name ?? (String(data.get("name") ?? "").trim().slice(0, 20) || user.name)
    try {
      await db()
        .prepare(
          `INSERT INTO passes (id, event, email, name, serial, created_at, student_id, class_name, phone)
           SELECT ?1, slug, ?3, ?4, COALESCE((SELECT MAX(serial) FROM passes WHERE event = ?2), 0) + 1, ?5, ?7, ?8, ?9
           FROM events
           WHERE slug = ?2 AND claim_from <= ?6 AND claim_until >= ?6
             AND (capacity IS NULL OR (SELECT COUNT(*) FROM passes WHERE event = ?2) < capacity)
           ON CONFLICT (event, email) DO NOTHING`,
        )
        .bind(randomId(), event.slug, user.email, name, Date.now(), new Date().toISOString(), attendee?.studentId ?? null, attendee?.className ?? null, attendee?.phone ?? null)
        .run()
    } catch (e) {
      if (!String(e).includes("UNIQUE")) throw e
      claimError = "这个学号已经领过券。如非本人，请联系发起人。"
    }
    if (await findPass()) {
      purgePages(Astro.url, [Astro.url.pathname])
      return Astro.redirect(`${Astro.url.pathname}?issued`, 303)
    }
  }
}

const claimed = counted!.n
const full = event.capacity !== null && claimed >= event.capacity
const phase = claimPhase(event)
const passNotice = pass?.redeemed_at
  ? `${formatTime(new Date(pass.redeemed_at).toISOString())} 已入场。`
  : checkInPhase(event) === "ended"
    ? "活动已结束。"
    : checkInPhase(event) === "open"
      ? "到场后撕开贴纸，给工作人员扫码。"
      : `${formatTime(checkInOpensAt(event))} 起可以撕开贴纸。`
const Design = passDesign(event.design)
const meeting = !!user?.member && !!pass?.redeemed_at && checkInPhase(event) === "open"
const [code, met] = meeting ? await Promise.all([pass!.meet_code ?? meetCode(pass!.id), metAt(event.slug, user!.member!.id)]) : [null, []]
const meetQr = code ? qrCode(`${Astro.url.origin}/meet/${code}`) : null
const repairFrom = event.repair ? checkInOpensAt(event) : null
const editable = canEdit(event, user, hosts)
const hosting = hosts.find((h) => h.email === user?.email)

const now = Date.now()
const milestones = [
  { at: event.claim_from, label: "开放领取" },
  { at: event.claim_until, label: "停止领取" },
  { at: event.starts_at, label: "活动开始" },
  { at: event.ends_at, label: "活动结束" },
].map((m) => ({ ...m, done: Date.parse(m.at) <= now }))
const start = new Date(event.starts_at)
const local = (options: Intl.DateTimeFormatOptions) => start.toLocaleString("en-US", { timeZone: ZONE, ...options })
const chip = {
  upcoming: { tone: "warn", text: "即将开放领取" },
  open: { tone: "ok", text: full ? "名额已满" : "正在领取" },
  closed: { tone: "", text: "领取已截止" },
}[phase]
const ended = checkInPhase(event) === "ended"
const left = event.capacity === null ? null : Math.max(0, event.capacity - claimed)
const summary = event.summary || (event.repair ? "现场免费维修，全校师生都能来。把电脑带过来，队员当场帮你看。可以先在网上预约，到场直接开始。" : "")
const map = `https://uri.amap.com/search?keyword=${encodeURIComponent(`浙大宁波理工学院 ${event.venue}`)}&city=330200&src=card.nbtca.space&callnative=1`
// The countdown points at what this visitor waits for next, not at every step of the schedule.
const target = ended
  ? null
  : pass || hosting || phase === "closed" || full
    ? Date.parse(event.starts_at) > now ? { at: event.starts_at, label: "开场" } : { at: event.ends_at, label: "结束" }
    : phase === "upcoming"
      ? { at: event.claim_from, label: "开放领取" }
      : { at: event.claim_until, label: "停止领取" }
const shareImage = event.share ? `${Astro.url.origin}${mediaUrl(event.share)}` : undefined
---

<Base title={`${event.title} · NBTCA`} description={`${formatRange(event.starts_at, event.ends_at)}，${event.venue}${summary ? `。${summary}` : ""}`} image={shareImage}>
  <main class="wrap">
    <div class="stage">
      <Lanyard drop={Astro.url.searchParams.has("issued")}>
        {hosting
          ? <Design event={event} pass={{ id: `host-${event.slug}`, serial: 0, redeemed_at: hosting.credited_at }} holder={hosting.name} guest={false} host transitionName={`pass-${event.slug}`} />
          : <Design event={event} pass={pass} holder={pass?.name ?? user?.name ?? "你的名字"} guest={!user?.member} transitionName={`pass-${event.slug}`} />}
      </Lanyard>
      <div class="spot" />
    </div>

    <section class="info">
      <span class="chip reveal" data-tone={hosting || pass ? "ok" : chip.tone}>{hosting ? "主办" : pass ? "已领取" : chip.text}</span>
      <h1 class="reveal" style="--i: 1">{event.title}</h1>

      <div class="when reveal" style="--i: 2">
        <span class="day">{local({ month: "2-digit" })}.{local({ day: "2-digit" })}</span>
        <span class="meta">
          <b>{local({ weekday: "long" })}</b>
          <span>
            {sameDay(event.starts_at, event.ends_at)
              ? `${formatClock(event.starts_at)}–${formatClock(event.ends_at)}`
              : `${formatClock(event.starts_at)} 开始，${formatTime(event.ends_at)} 结束`}
          </span>
          <a class="venue" href={map} target="_blank" rel="noopener">
            {event.venue}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /></svg>
          </a>
          {event.venue_note && <small>{event.venue_note}</small>}
        </span>
      </div>

      {repairFrom && Date.parse(repairFrom) <= Date.now() && <RepairTally from={repairFrom} until={event.ends_at} />}

      <div class="act reveal" style="--i: 3">
        {(target || left !== null) && (
          <p class="status">
            {target && <span class="countdown" data-target={target.at}><span data-left>…</span> 后{target.label}</span>}
            {left !== null && !pass && !hosting && phase !== "closed" && !ended && <span>{left ? `还剩 ${left} 个名额` : "名额已满"}</span>}
          </p>
        )}
        {hosting
          ? <p class="notice">{hosting.credited_at ? "你是这场活动的发起人，主办券已计入入场次数。" : ended ? "这场活动没有来宾入场，主办券不计入入场次数。" : "你是这场活动的发起人，不用领券。第一位来宾入场后，主办券计入你的入场次数。"}</p>
          : pass
          ? (
              <div class="issued" data-issued={Astro.url.searchParams.has("issued") ? "" : undefined}>
                <p class="notice" data-pass-notice>{passNotice}</p>
                {!pass.redeemed_at && !ended && (
                  <a class="button" href={`/e/${event.slug}/calendar.ics`} title="开场前半小时提醒" data-calendar>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="3" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
                    加入日历
                  </a>
                )}
              </div>
            )
          : phase === "upcoming"
            ? <p class="notice">{formatTime(event.claim_from)} 开放领取。</p>
            : phase === "closed"
              ? <p class="notice">领取已于 {formatTime(event.claim_until)} 截止。</p>
              : full
                ? <p class="notice">名额已满。</p>
                : user
                  ? (
                      <form class="form claim" method="post">
                        {claimError && <p class="notice error">{claimError}</p>}
                        {event.needs_info
                          ? (
                              <fieldset class="credit">
                                <legend>学分登记</legend>
                                <p>可申报学分，信息只交给发起人。</p>
                                <label>姓名<input name="name" required maxlength="20" autocomplete="name" value={form.name} /></label>
                                <label>学号<input name="student_id" required inputmode="numeric" pattern="[23][0-9]{9}" maxlength="10" value={form.studentId} data-student-id /><small data-student-hint /></label>
                                <label>班级<input name="class_name" required minlength="2" maxlength="20" placeholder="计算机 2101" value={form.className} /></label>
                                <label>手机号<input name="phone" required type="tel" inputmode="numeric" pattern="1[3-9][0-9]{9}" maxlength="11" autocomplete="tel" value={form.phone} /></label>
                              </fieldset>
                            )
                          : !user.member && <label>券上的名字<input name="name" maxlength="20" required value={user.name} /></label>}
                        <button class="button">领取入场券</button>
                      </form>
                    )
                  : (
                      <div class="signin">
                        <a class="button" href={`/login?next=${encodeURIComponent(Astro.url.pathname)}`}>领取入场券</a>
                        <small>用 NBTCA 账号登录后领取，没有账号可以当场注册。</small>
                      </div>
                    )}
        <div class="extras">
          {event.repair === 1 && !ended && (
            <a class="action" href="https://nbtca.space/repair/create-ticket" title="填好机型和问题，到场直接开始">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 5.5a4 4 0 0 0-5 5L4 16a2.12 2.12 0 0 0 3 3l5.5-5.5a4 4 0 0 0 5-5l-2.5 2.5-2.5-.5-.5-2.5z" /></svg>
              预约维修
            </a>
          )}
          <SharePoster
          label={pass ? "保存分享图" : "生成分享图"}
          sources={{ footage: ".stage video" }}
          spec={{
            word: event.word,
            eyebrow: ["NBTCA Event Pass", local({ day: "numeric", month: "short", year: "numeric" })],
            holder: pass?.name ?? "一起来吧",
            tag: pass ? (user?.member ? "Member" : "Guest") : "Invite",
            title: event.title,
            facts: [
              ["Venue", event.venue],
              ["Date", formatDay(start)],
              ["Time", formatClock(event.starts_at)],
            ],
            link: `${Astro.url.origin}/e/${event.slug}`,
            linkLabel: phase === "open" && !full ? "扫码领券" : "扫码看活动",
          }}
          />
        </div>
      </div>

      {summary && <p class="summary reveal" style="--i: 4">{summary}</p>}
      {event.album && (
        <a class="action album reveal" style="--i: 4" href={event.album}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="3" /><path d="m4 16 4.5-4.5 4 4 2.5-2.5 5 5" /><circle cx="15.5" cy="9.5" r="1.5" /></svg>
          活动相册
        </a>
      )}
      {(hosts.length > 0 || editable) && (
        <div class="host reveal" style="--i: 4">
          {hosts.length > 0 && (
            <span class="by">
              <span class="avatars">{hosts.map((h) => <a href={`/members/${h.id}`} class="avatar" style={`--hue: ${h.hue}`} title={h.name}>{[...h.name][0]}</a>)}</span>
              <span>由 {hosts.map((h, i) => <>{i > 0 && "、"}<a href={`/members/${h.id}`}>{h.name}</a></>)} 发起</span>
            </span>
          )}
          {editable && (
            <a class="action" href={`/e/${event.slug}/edit`} title="编辑活动、查看领取名单">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9a2.83 2.83 0 0 0-4-4L4 16z" /><path d="m13.5 6.5 4 4" /></svg>
              管理活动
            </a>
          )}
        </div>
      )}

      <details class="schedule reveal" style="--i: 5">
        <summary>完整时间安排</summary>
        <Timeline steps={milestones} />
        {event.capacity !== null && (
          <div class="meter" style={`--fill: ${Math.min(1, claimed / event.capacity)}`}>
            <span />
            <small>已领取 {claimed} / {event.capacity}</small>
          </div>
        )}
      </details>
      {meetQr && (
        <div class="meet reveal" style="--i: 7">
          <svg class="code" viewBox={`-2 -2 ${meetQr.size + 4} ${meetQr.size + 4}`} shape-rendering="crispEdges" aria-label="认识一下的二维码"><path d={meetQr.path} /></svg>
          <div>
            <b>认识一下</b>
            <p class="muted">让同场的社员用相机扫这个码。</p>
            {met.length > 0 && (
              <ul>
                {met.map((m) => <li><a href={`/members/${m.id}`}><span class="avatar" style={`--hue: ${m.hue}`}>{[...m.name][0]}</span>{m.name}</a></li>)}
              </ul>
            )}
          </div>
        </div>
      )}
    </section>
  </main>
</Base>

<script>
  import { checkStudentId, describeStudentId } from "../../../lib/attendee"
  import { formatClock } from "../../../lib/format"

  const idInput = document.querySelector<HTMLInputElement>("[data-student-id]")
  const idHint = document.querySelector<HTMLElement>("[data-student-hint]")
  if (idInput && idHint) {
    const check = () => {
      const id = idInput.value.replace(/\s/g, "")
      const error = id.length === 10 ? checkStudentId(id) : null
      idInput.setCustomValidity(error ?? "")
      idHint.textContent = error ?? (id.length === 10 ? describeStudentId(id) : "")
      if (error) idHint.dataset.bad = ""
      else delete idHint.dataset.bad
    }
    idInput.addEventListener("input", check)
    check()
  }
  const el = document.querySelector<HTMLElement>("[data-target]")
  if (el) {
    const left = el.querySelector("[data-left]")!
    const target = Date.parse(el.dataset.target!)
    const pad = (n: number) => String(n).padStart(2, "0")
    const tick = () => {
      const s = Math.max(0, Math.floor((target - Date.now()) / 1000))
      // Only the last day ticks; further out, a whole number of days reads calmer.
      left.textContent = s >= 86400 ? `${Math.ceil(s / 86400)} 天` : `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`
      // Signed-out visitors get a shared copy up to a minute old, so the refresh asks past it.
      if (s === 0) location.replace(`${location.pathname}?fresh`)
    }
    tick()
    setInterval(tick, 1000)
  }
  if (location.search) history.replaceState(null, "", location.pathname)

  const notice = document.querySelector<HTMLElement>("[data-pass-notice]")
  const say = (text: string) => {
    if (!notice) return
    notice.textContent = text
    notice.animate([{ opacity: 0.4 }, { opacity: 1 }], { duration: 300 })
  }
  addEventListener("pass:locked", () => notice?.animate([{ scale: 1 }, { scale: 1.03 }, { scale: 1 }], { duration: 300 }))
  addEventListener("pass:redeemed", (e) => {
    const at = new Date((e as CustomEvent<{ at: number }>).detail.at)
    say(`${formatClock(at)} 已入场，玩得开心。`)
    document.querySelector("[data-calendar]")?.remove()
  })
</script>

<style>
  main {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: 3rem 5rem;
    min-height: calc(100svh - 8rem);
    padding-block: 2rem 4rem;
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: 2rem;
  }

  .spot {
    position: absolute;
    inset: 10% 5% -5%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(59 141 255 / 0.28), transparent);
    filter: blur(30px);
  }

  .info {
    display: grid;
    justify-items: start;
    gap: 1.6rem;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.05;
  }

  .when {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .day {
    font: 800 clamp(3.2rem, 7vw, 5rem) / 0.85 var(--wide);
    font-stretch: 125%;
    letter-spacing: -0.03em;
    background: linear-gradient(120deg, var(--fg) 30%, var(--glow));
    background-clip: text;
    color: transparent;
  }

  .meta {
    display: grid;
    gap: 0.3rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--muted);
  }

  .venue {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
  }

  .venue svg {
    width: 0.95em;
    height: 0.95em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .meta small {
    max-width: 20em;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--faint);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .status .countdown {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .issued {
    display: grid;
    gap: 0.75rem;
  }

  .issued[data-issued] .notice {
    animation: arrive 0.6s var(--ease) both;
  }

  @keyframes arrive {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  .issued .button,
  .signin .button,
  .claim .button {
    width: 100%;
  }

  .signin {
    display: grid;
    gap: 0.6rem;
  }

  .signin small {
    font-size: 0.8rem;
    color: var(--faint);
    text-align: center;
  }

  .schedule {
    width: 100%;
  }

  .schedule summary {
    font-size: 0.85rem;
    color: var(--muted);
    cursor: pointer;
  }

  .schedule[open] summary {
    margin-bottom: 1.25rem;
  }

  .schedule .meter {
    margin-top: 1.25rem;
  }

  .meta b {
    font: 700 0.78rem / 1 var(--wide);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .album {
    justify-self: start;
  }

  .summary {
    margin: 0;
    max-width: 32em;
    line-height: 1.8;
    color: var(--muted);
  }

  .host {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .by {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }

  .by a {
    color: inherit;
    text-decoration: none;
  }

  .avatars {
    display: flex;
  }

  .avatars .avatar + .avatar {
    margin-left: -0.5rem;
    box-shadow: 0 0 0 2px var(--bg);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 1.8rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(135deg, oklch(0.7 0.16 var(--hue)), oklch(0.45 0.16 calc(var(--hue) + 40)));
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--fg);
  }

  .extras {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .meet {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
  }

  .meet .code {
    flex: none;
    width: 7.5rem;
    aspect-ratio: 1;
    border-radius: 0.75rem;
    background: #fff;
    fill: #0b0d12;
  }

  .meet b {
    font-size: 1.05rem;
  }

  .meet p {
    margin: 0.35rem 0 0;
    font-size: 0.88rem;
  }

  .meet ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .meet li a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.7rem 0.2rem 0.2rem;
