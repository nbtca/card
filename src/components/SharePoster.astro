---
import type { BadgeSpec } from "../lib/badge"
import type { PosterSpec } from "../lib/poster"

type Props = { label?: string; hint?: string } & (
  | { kind?: "poster"; spec: Omit<PosterSpec, "footage">; sources?: { footage?: string } }
  | { kind: "badge"; spec: Omit<BadgeSpec, "background" | "portrait">; sources?: { background?: string; portrait?: string } }
)

// Sources are selectors for media already on the page, drawn as they are now.
const { kind = "poster", spec, sources = {}, label = "生成分享图", hint = "长按保存。" } = Astro.props
---

<button class="action" type="button" data-poster={JSON.stringify(spec)} data-kind={kind} data-sources={JSON.stringify(sources)}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 14V3.5m0 0L7.5 8M12 3.5 16.5 8" /><path d="M5 12v6a2.5 2.5 0 0 0 2.5 2.5h9A2.5 2.5 0 0 0 19 18v-6" /></svg>
  <span data-poster-label>{label}</span>
</button>
<dialog class="poster-dialog panel" data-poster-dialog data-kind={kind} aria-label={label}>
  <img alt={label} data-poster-image />
  <p class="muted">{hint}</p>
  <div class="row">
    <button class="button" type="button" data-poster-share hidden>分享</button>
    <button class="button ghost" type="button" data-poster-close>关闭</button>
  </div>
</dialog>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-poster]")) {
    const dialog = button.nextElementSibling as HTMLDialogElement
    const image = dialog.querySelector<HTMLImageElement>("[data-poster-image]")!
    const share = dialog.querySelector<HTMLButtonElement>("[data-poster-share]")!
    let file: File | null = null

    button.addEventListener("click", async () => {
      const text = button.querySelector<HTMLElement>("[data-poster-label]")!
      const label = text.textContent
      button.disabled = true
      text.textContent = "正在生成…"
      const media = Object.entries(JSON.parse(button.dataset.sources!) as Record<string, string>).map(([key, selector]) => {
        const source = document.querySelector<HTMLVideoElement | HTMLImageElement>(selector)
        const ready = source instanceof HTMLVideoElement ? source.readyState >= 2 : !!source?.complete && !!source.naturalWidth
        return [key, ready ? source : null]
      })
      const spec = { ...JSON.parse(button.dataset.poster!), ...Object.fromEntries(media) }
      const badge = button.dataset.kind === "badge"
      // Loaded on demand: few visitors make an image, so the drawing code and QR encoder stay out of the page.
      const [blob, { dissolveMask }] = await Promise.all([
        badge ? import("../lib/badge").then((m) => m.drawBadge(spec)) : import("../lib/poster").then((m) => m.drawPoster(spec)),
        import("../lib/dissolve"),
      ])
      file = new File([blob], `nbtca${badge ? "-badge" : ""}.${blob.type.split("/")[1]}`, { type: blob.type })
      URL.revokeObjectURL(image.src)
      image.src = URL.createObjectURL(blob)
      image.style.setProperty("--sprite", dissolveMask({ cols: 8, rows: 12, seed: Date.now() % 97 }))
      share.hidden = !navigator.canShare?.({ files: [file] })
      button.disabled = false
      text.textContent = label
      dialog.showModal()
    })
    share.addEventListener("click", () => file && navigator.share({ files: [file] }).catch(() => {}))
    dialog.querySelector("[data-poster-close]")!.addEventListener("click", () => dialog.close())
    dialog.addEventListener("click", (e) => e.target === dialog && dialog.close())
  }
</script>

<style>
  .poster-dialog {
    width: min(26rem, calc(100vw - 32px));
    max-height: calc(100svh - 32px);
    margin: auto;
    padding: 1.25rem;
    overflow: auto;
    color: var(--fg);
    background: var(--bg);
  }

  .poster-dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(6px);
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: 1rem;
    -webkit-touch-callout: default;
  }

  [data-kind="badge"] img {
    width: min(100%, 18rem);
    margin-inline: auto;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  /* The picture develops cell by cell, the same way stubs arrive on the entry wall. */
  .poster-dialog[open] img {
    mask: var(--sprite) 0 0 / 1500% 100% no-repeat;
    animation: develop 0.8s steps(15, jump-none) both;
  }

  @keyframes develop {
    from {
      mask-position: 0% 0;
    }
    to {
      mask-position: 100% 0;
    }
  }

  p {
    margin: 1rem 0;
    font-size: 0.88rem;
    text-align: center;
  }

  .row {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
