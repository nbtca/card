---
import { passDesign } from "../cards/pass"
import { claimPhase, formatRange, formatShort, type Event } from "../lib/db"

interface Props {
  events: Event[]
}

const status = (e: Event) =>
  ({
    upcoming: { tone: "warn", text: `${formatShort(e.claim_from)} 开放领取` },
    open: { tone: "ok", text: "正在领取" },
    closed: { tone: "", text: "领取已截止" },
  })[claimPhase(e)]
---

<ul>
  {Astro.props.events.map((e, i) => {
    const Design = passDesign(e.design)
    const { tone, text } = status(e)
    return (
      <li class="reveal" style={`--i: ${i}`}>
        <Design event={e} pass={null} holder="你的名字" guest size="thumb" />
        <div class="caption">
          <span class="chip" data-tone={tone}>{text}</span>
          <a href={`/e/${e.slug}`}><h3>{e.title}</h3></a>
          <p>{formatRange(e.starts_at, e.ends_at)}<br />{e.venue}</p>
        </div>
      </li>
    )
  })}
</ul>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
    gap: 3.5rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 560px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.25rem 1rem;
    }

    h3 {
      font-size: 1rem;
    }
  }

  li {
    min-width: 0;
    display: grid;
    gap: 1.4rem;
    align-content: start;
  }

  .caption {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    padding-inline: 0.25rem;
  }

  .caption .chip {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .caption a {
    text-decoration: none;
  }

  h3 {
    font-size: 1.2rem;
  }

  p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--muted);
  }
</style>
