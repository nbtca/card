---
import { passDesign } from "../cards/pass"
import { checkInPhase, claimPhase, type Event } from "../lib/db"
import { formatClock, formatDate, formatRange, formatShort, sameDay } from "../lib/format"

interface Props {
  events: Event[]
}

const now = new Date().toISOString()
// On the day itself, the time matters more than whether claiming is open.
const status = (e: Event) =>
  checkInPhase(e) === "ended" ? { tone: "", text: "已结束" }
  : e.starts_at <= now ? { tone: "ok", text: `进行中，${formatClock(e.ends_at)} 结束` }
  : sameDay(e.starts_at, now) ? { tone: "ok", text: `今天 ${formatClock(e.starts_at)} 开场` }
  : ({
    upcoming: { tone: "warn", text: `${formatShort(e.claim_from)} 开放领取` },
    open: { tone: "ok", text: "正在领取" },
    closed: { tone: "", text: "领取已截止" },
  })[claimPhase(e)]
---

<ul>
  {Astro.props.events.map((e) => {
    const Design = passDesign(e.design)
    const { tone, text } = status(e)
    return (
      <li class="rise">
        <Design event={e} pass={null} holder="" guest size="thumb" transitionName={`pass-${e.slug}`} />
        <div class="caption">
          <span class="chip" data-tone={tone}>{text}</span>
          <a href={`/e/${e.slug}`}><h3>{e.title}</h3></a>
          <p>
            {sameDay(e.starts_at, e.ends_at)
              ? <>{formatDate(e.starts_at)}<br />{formatClock(e.starts_at)}–{formatClock(e.ends_at)}</>
              : formatRange(e.starts_at, e.ends_at)}
            <br />{e.venue}
          </p>
        </div>
      </li>
    )
  })}
</ul>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
    gap: 3.5rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 560px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.25rem 1rem;
    }

    h3 {
      font-size: 1rem;
    }
  }

  li {
    min-width: 0;
    display: grid;
    gap: 1.4rem;
    align-content: start;
  }

  .caption {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    padding-inline: 0.25rem;
  }

  .caption .chip {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .caption a {
    text-decoration: none;
  }

  h3 {
    font-size: 1.2rem;
  }

  /* Safari wraps text-wrap: pretty again inside a shrink-to-fit box, so the paragraph takes the full column. */
  p {
    justify-self: stretch;
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--muted);
  }
</style>
