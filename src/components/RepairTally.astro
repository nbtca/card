---
// Either the tickets opened during a repair day, or the tickets one member took on.
type Props = ({ from: string; until: string; alias?: never } | { alias: string; from?: never; until?: never }) & {
  // The entry wall shows only the counts, large; other pages also list the latest tickets.
  compact?: boolean
  eyebrow?: string
  title?: string
}

const { from, until, alias, compact = false, eyebrow, title } = Astro.props
---

<section class:list={["tally", { compact }]} data-repair-tally data-from={from} data-until={until} data-alias={alias} hidden>
  {title && (
    <header>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
    </header>
  )}
  {alias
    ? <p class="counts">接过<b data-received>0</b>单<span>·</span>修好<b data-fixed>0</b>台</p>
    : <p class="counts"><b data-received>0</b>台已接待<span>·</span><b data-fixed>0</b>台已修好</p>}
  {!compact && <ul data-list />}
</section>

<script>
  import { fetchMemberRepairs, fetchRepairsBetween, type Repair } from "../lib/repair"

  const LISTED = 6
  const POLL = 30_000
  const status = (r: Repair) => (r.cancelled ? "已取消" : ["等待接单", "维修中", "已修好", "已完成"][r.steps.findLastIndex((s) => s.done)])

  for (const tally of document.querySelectorAll<HTMLElement>("[data-repair-tally]")) {
    const { from, until, alias } = tally.dataset
    const list = tally.querySelector("[data-list]")
    const show = (repairs: Repair[] | null) => {
      if (!repairs) return
      const kept = repairs.filter((r) => !r.cancelled)
      tally.querySelector("[data-received]")!.textContent = String(kept.length)
      tally.querySelector("[data-fixed]")!.textContent = String(kept.filter((r) => r.steps[2]!.done).length)
      list?.replaceChildren(
        ...kept.slice(0, LISTED).map((r) => {
          const li = document.createElement("li")
          const a = Object.assign(document.createElement("a"), { href: `/r/${r.id}` })
          const [serial, model, state] = ["span", "b", "small"].map((t) => document.createElement(t))
          serial!.textContent = `№ ${String(r.id).padStart(4, "0")}`
          model!.textContent = r.model || "未填写机型"
          state!.textContent = status(r)!
          a.append(serial!, model!, state!)
          li.append(a)
          return li
        }),
      )
      tally.hidden = kept.length === 0
    }
    // A repair day's page may stay open on a projector all day, so it keeps checking until the event ends.
    const load = () =>
      (alias ? fetchMemberRepairs(alias) : fetchRepairsBetween(from!, until!))
        .then(show, () => {})
        .finally(() => until && Date.now() < Date.parse(until) && setTimeout(load, POLL))
    load()
  }
</script>

<style>
  .tally {
    display: grid;
    gap: 0.9rem;
    width: 100%;
  }

  header {
    display: grid;
    gap: 0.7rem;
    margin-bottom: 0.6rem;
  }

  h2 {
    font: 800 clamp(1.5rem, 3vw, 2rem) / 1.1 var(--wide);
    font-stretch: 112%;
  }

  .counts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    margin: 0;
    color: var(--muted);
  }

  .counts b {
    font: 800 1.4rem / 1 var(--wide);
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .counts span {
    margin-inline: 0.3rem;
    color: var(--faint);
  }

  ul {
    display: grid;
    gap: 0.4rem;
    max-width: 40rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The list is built by the script, so its items carry no scoped attribute. */
  ul :global(a) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    font-size: 0.88rem;
    text-decoration: none;
  }

  ul :global(span) {
    font: 600 0.72rem / 1 var(--wide);
    letter-spacing: 0.12em;
    color: var(--faint);
  }

  ul :global(b) {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  ul :global(small) {
    color: var(--muted);
  }

  .compact .counts {
    font-size: 1.15rem;
  }

  .compact .counts b {
    font-size: 1.6rem;
  }
</style>
