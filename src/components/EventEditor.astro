---
import { passDesign, passDesigns } from "../cards/pass"
import type { Event, Member } from "../lib/db"
import { MAX_VIDEO_MB, MAX_VIDEO_SECONDS, toLocal } from "../lib/events"
import { SHANGHAI, closesPresets, formatWallDay, matchCloses, matchOpens, opensPresets, parseWall, summarize, toWall } from "../lib/schedule"

interface Props {
  event: Event
  isNew: boolean
  error?: { error: string; field?: string }
  saved?: boolean
  holder: string
  members: Member[]
  hosts: string[]
  claimed?: number
}

const { event, isNew, error, saved = false, holder, members, hosts, claimed = 0 } = Astro.props
const invalid = (field: string) => (error?.field === field ? { "aria-invalid": true, "aria-describedby": "form-error" } as const : {})
const errorAt = (field: string) => (error?.field === field ? error.error : "")
const Design = passDesign(event.design)
const [opens, closes, start, end] = (["claim_from", "claim_until", "starts_at", "ends_at"] as const).map((name) => parseWall(toLocal(event[name]))) as [number, number, number, number]
const thisYear = new Date(Date.now() + SHANGHAI).getUTCFullYear()
const opensPick = matchOpens(opens, start)
const closesPick = matchCloses(closes, start, end)
const day = (ms: number) => toWall(ms).slice(0, 10)
const clock = (ms: number) => toWall(ms).slice(11)
const crossDay = day(start) !== day(end)
---

<div class="studio">
  <aside class="preview">
    <Design event={event} pass={null} holder={holder} guest={false} host />
    <p class="hint">实时预览</p>
  </aside>

  <form class="sheets form" method="post" enctype="multipart/form-data">
    {error && !error.field && <p class="notice error" id="form-error">{error.error}</p>}

    <section class="panel">
      <h2><span>01</span>卡面</h2>
      <label>活动名称<input name="title" required maxlength="40" value={event.title} data-live="title" placeholder="理工维修日" {...invalid("title")} />{errorAt("title") && <p class="field-error" id="form-error">{errorAt("title")}</p>}</label>
      <label>
        卡面大字
        <input class="big" name="word" required maxlength="16" value={event.word} data-live="word" placeholder="fix" {...invalid("word")} />
        {errorAt("word") && <p class="field-error" id="form-error">{errorAt("word")}</p>}
        <small>视频从字里透出，2 到 6 个字符最好。</small>
      </label>
      {isNew && (
        <label>
          链接名
          <span class="slug"><em>card.nbtca.space/e/</em><input name="slug" required pattern="[a-z0-9](?:[a-z0-9]|-){1,40}" title="小写字母、数字和连字符，至少两个字符" placeholder="repair-day" value={event.slug} {...invalid("slug")} /></span>
          {errorAt("slug") && <p class="field-error" id="form-error">{errorAt("slug")}</p>}
          <small>小写字母、数字和连字符，创建后不可改。</small>
        </label>
      )}
      {Object.keys(passDesigns).length > 1 && (
        <label>
          卡面设计
          <select name="design">
            {Object.keys(passDesigns).map((name) => <option selected={name === event.design}>{name}</option>)}
          </select>
        </label>
      )}
    </section>

    <section class="panel">
      <h2><span>02</span>时间</h2>
      <div class="schedule" data-schedule data-year={thisYear} data-claimed={claimed}>
        {(["claim_from", "claim_until", "starts_at", "ends_at"] as const).map((name) => (
          <input type="hidden" name={name} value={toLocal(event[name])} data-out={name} />
        ))}
        <div class="row">
          <span>日期</span>
          <div class="range"><label class="pick"><span data-show="start-day">{formatWallDay(start, thisYear)}</span><input type="date" required value={day(start)} data-in="start-day" aria-label="活动日期" /></label></div>
        </div>
        <div class="row">
          <span>时间</span>
          <div class="range">
            <label class="pick"><span data-show="start-time">{clock(start)}</span><input type="time" required value={clock(start)} data-in="start-time" aria-label="开始时间" /></label>
            <i>–</i>
            <label class="pick" hidden={!crossDay}><span data-show="end-day">{formatWallDay(end, thisYear)}</span><input type="date" required value={day(end)} data-in="end-day" aria-label="结束日期" /></label>
            <label class="pick"><span data-show="end-time">{clock(end)}</span><input type="time" required value={clock(end)} data-in="end-time" aria-label="结束时间" /></label>
          </div>
        </div>
        <label class="check cross"><input type="checkbox" checked={crossDay} data-in="cross" />在另一天结束</label>
        <hr />
        <div class="row">
          <span>开放领取</span>
          <div class="range">
            <select data-in="opens" aria-label="开放领取">
              {opensPresets.map(([label], i) => <option value={i} selected={i === opensPick}>{label}</option>)}
              {isNew && <option value="now">现在</option>}
              <option value="custom" selected={opensPick < 0}>自定义</option>
            </select>
            <label class="pick" hidden={opensPick >= 0}><span data-show="opens-day">{formatWallDay(opens, thisYear)}</span><input type="date" value={day(opens)} data-in="opens-day" aria-label="开放领取日期" /></label>
            <label class="pick" hidden={opensPick >= 0}><span data-show="opens-time">{clock(opens)}</span><input type="time" value={clock(opens)} data-in="opens-time" aria-label="开放领取时间" /></label>
          </div>
        </div>
        <div class="row">
          <span>停止领取</span>
          <div class="range">
            <select data-in="closes" aria-label="停止领取">
              {closesPresets.map(([label], i) => <option value={i} selected={i === closesPick}>{label}</option>)}
              <option value="custom" selected={closesPick < 0}>自定义</option>
            </select>
            <label class="pick" hidden={closesPick >= 0}><span data-show="closes-day">{formatWallDay(closes, thisYear)}</span><input type="date" value={day(closes)} data-in="closes-day" aria-label="停止领取日期" /></label>
            <label class="pick" hidden={closesPick >= 0}><span data-show="closes-time">{clock(closes)}</span><input type="time" value={clock(closes)} data-in="closes-time" aria-label="停止领取时间" /></label>
          </div>
        </div>
        <p class="summary" data-summary aria-live="polite">{summarize(opens, closes, start, end, thisYear)}</p>
        {errorAt("schedule") && <p class="field-error" id="form-error">{errorAt("schedule")}</p>}
        <p class="moved" data-moved hidden>已有 {claimed} 人领取，保存后他们的票会显示新的时间。</p>
      </div>
    </section>

    <section class="panel">
      <h2><span>03</span>地点与名额</h2>
      <label>地点<input name="venue" required maxlength="40" value={event.venue} data-live="venue" placeholder="图书馆一楼大厅" {...invalid("venue")} />{errorAt("venue") && <p class="field-error" id="form-error">{errorAt("venue")}</p>}</label>
      <div class="group">
        <label class="switch">
          <span>限制名额<small>不限制时，开放期间谁都能领。</small></span>
          <input type="checkbox" role="switch" checked={event.capacity !== null} data-limit />
        </label>
        <label class="count" hidden={event.capacity === null && error?.field !== "capacity"}>
          最多
          <input name="capacity" type="number" inputmode="numeric" min={Math.max(1, claimed)} step="1" value={event.capacity ?? ""} placeholder="50" disabled={event.capacity === null && error?.field !== "capacity"} {...invalid("capacity")} />
          人{claimed > 0 && <small>已领取 {claimed} 人</small>}
        </label>
        {errorAt("capacity") && <p class="field-error" id="form-error">{errorAt("capacity")}</p>}
        <label class="switch">
          <span>登记学生信息<small>领取时填写学号、姓名、班级和手机号，用于学分申报。只有发起人和管理员能看到。</small></span>
          <input name="needs_info" type="checkbox" role="switch" checked={event.needs_info === 1} />
        </label>
        <label class="switch">
          <span>维修日<small>活动页和入场大屏会显示现场修了几台。</small></span>
          <input name="repair" type="checkbox" role="switch" checked={event.repair === 1} />
        </label>
      </div>
      <label>
        活动相册
        <input name="album" type="url" value={event.album ?? ""} placeholder="https://photo.nbtca.space/…" {...invalid("album")} />
        {errorAt("album") ? <p class="field-error" id="form-error">{errorAt("album")}</p> : <small>活动结束后填写 photo.nbtca.space 的相册链接。</small>}
      </label>
      <fieldset class="hosts">
        <legend>发起人</legend>
        <p>发起人领到主办券，不占名额，活动开始后计入入场次数。</p>
        <div class="people" data-people>
          {members.map((m) => {
            const on = hosts.includes(m.id)
            const owner = m.email === event.created_by
            return (
              <label class="person" hidden={!on} data-person={m.name.toLowerCase()} data-name={m.name}>
                <input name="hosts" type="checkbox" value={m.id} checked={on} disabled={owner} hidden />
                {m.name}
                {owner ? <small>创建者</small> : <button type="button" aria-label={`移除 ${m.name}`} data-remove>×</button>}
              </label>
            )
          })}
        </div>
        <div class="find">
          <input type="search" placeholder="输入名字添加社员" aria-label="添加发起人" autocomplete="off" data-find />
          <ul data-results hidden></ul>
        </div>
      </fieldset>
      <label>简介<textarea name="summary" rows="3" maxlength="200" placeholder="一句话介绍">{event.summary}</textarea></label>
    </section>

    <section class="panel">
      <h2><span>04</span>卡面视频</h2>
      <label class="drop">
        <input name="video" type="file" {...invalid("video")} accept="video/mp4,video/webm" data-live="video" data-max-mb={MAX_VIDEO_MB} data-max-seconds={MAX_VIDEO_SECONDS} />
        <input name="poster" type="file" hidden data-poster />
        <strong data-file>{event.video ? "更换视频" : "选择一段视频"}</strong>
        {errorAt("video") && <p class="field-error" id="form-error">{errorAt("video")}</p>}
        <small>{MAX_VIDEO_SECONDS} 秒、{MAX_VIDEO_MB}MB 以内的 MP4 或 WebM，可以不传。</small>
      </label>
    </section>

    <div class="submit" data-submit>
      <p aria-live="polite" data-state>{error ? "还没有保存" : saved ? "已保存" : isNew ? "" : "没有未保存的修改"}</p>
      {isNew && <a class="button ghost" href="/e">取消</a>}
      <button class="button" disabled={!isNew && !error}>{isNew ? "发布活动" : "保存修改"}</button>
    </div>
  </form>
</div>

<script>
  import { SHANGHAI, closesAt, formatWallDay, opensAt, parseWall, scheduleError, summarize, toWall } from "../lib/schedule"

  const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  const bind = (name: string, value: string) =>
    document.querySelectorAll<HTMLElement>(`.preview [data-bind=${name}]`).forEach((el) => (el.textContent = value))
  const input = (name: string) => document.querySelector<HTMLInputElement>(`[data-live=${name}]`)!

  for (const name of ["title", "venue"]) {
    input(name).addEventListener("input", (e) => bind(name, (e.target as HTMLInputElement).value || " "))
  }
  input("word").addEventListener("input", (e) => {
    bind("word", (e.target as HTMLInputElement).value || " ")
    dispatchEvent(new Event("card:refit"))
  })
  const schedule = document.querySelector<HTMLElement>("[data-schedule]")!
  const thisYear = Number(schedule.dataset.year)
  const claimed = Number(schedule.dataset.claimed)
  const field = (name: string) => schedule.querySelector<HTMLInputElement>(`[data-in=${name}]`)!
  const out = (name: string) => schedule.querySelector<HTMLInputElement>(`[data-out=${name}]`)!
  const wallOf = (dayName: string, timeName: string) => parseWall(`${field(dayName).value}T${field(timeName).value}`)
  const setPair = (prefix: string, ms: number) => {
    if (Number.isNaN(ms)) return
    field(`${prefix}-day`).value = toWall(ms).slice(0, 10)
    field(`${prefix}-time`).value = toWall(ms).slice(11)
  }
  const opensPick = field("opens")
  const closesPick = field("closes")
  const cross = field("cross")
  const firstStart = parseWall(out("starts_at").value)

  const render = () => {
    const start = wallOf("start-day", "start-time")
    const end = wallOf(cross.checked ? "end-day" : "start-day", "end-time")
    const opensValue = opensPick.value
    const opens = opensValue === "custom" ? wallOf("opens-day", "opens-time")
      : opensValue === "now" ? Math.floor((Date.now() + SHANGHAI) / 6e4) * 6e4
      : opensAt(Number(opensValue), start)
    const closes = closesPick.value === "custom" ? wallOf("closes-day", "closes-time") : closesAt(Number(closesPick.value), start, end)
    if (opensValue !== "custom") setPair("opens", opens)
    if (closesPick.value !== "custom") setPair("closes", closes)
    if (!cross.checked) field("end-day").value = field("start-day").value

    for (const prefix of ["opens", "closes"]) {
      const custom = field(prefix).value === "custom"
      schedule.querySelectorAll<HTMLElement>(`[data-show^=${prefix}-]`).forEach((el) => (el.parentElement!.hidden = !custom))
    }
    field("end-day").parentElement!.hidden = !cross.checked
    for (const el of schedule.querySelectorAll<HTMLElement>("[data-show]")) {
      const value = field(el.dataset.show!).value
      el.textContent = el.dataset.show!.endsWith("-day") && value ? formatWallDay(parseWall(`${value}T00:00`), thisYear) : value || "—"
    }

    const error = scheduleError(opens, closes, start, end)
    const summary = schedule.querySelector<HTMLElement>("[data-summary]")!
    summary.textContent = summarize(opens, closes, start, end, thisYear)
    summary.classList.toggle("bad", !!error)
    schedule.querySelector<HTMLElement>("[data-show=end-time]")!.classList.toggle("bad", end <= start)
    schedule.querySelector<HTMLElement>("[data-moved]")!.hidden = !(claimed > 0 && start !== firstStart)
    for (const [name, ms] of [["claim_from", opens], ["claim_until", closes], ["starts_at", start], ["ends_at", end]] as const) {
      out(name).value = Number.isNaN(ms) ? "" : toWall(ms)
    }
    if (Number.isNaN(start)) return
    const d = new Date(start)
    bind("date", `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`)
    bind("day", `${d.getUTCMonth() + 1}月${d.getUTCDate()}日`)
    bind("time", toWall(start).slice(11))
  }

  // Moving the start carries the end along, the way Calendar keeps an event's length.
  let length = wallOf("end-day", "end-time") - wallOf("start-day", "start-time")
  for (const name of ["start-day", "start-time"]) {
    field(name).addEventListener("change", () => {
      const start = wallOf("start-day", "start-time")
      if (!Number.isNaN(start) && length > 0) {
        setPair("end", start + length)
        cross.checked = field("end-day").value !== field("start-day").value
      }
      render()
    })
  }
  for (const name of ["end-day", "end-time", "cross"]) {
    field(name).addEventListener("change", () => {
      if (!cross.checked) field("end-day").value = field("start-day").value
      render()
      length = wallOf("end-day", "end-time") - wallOf("start-day", "start-time")
    })
  }
  for (const name of ["opens", "closes", "opens-day", "opens-time", "closes-day", "closes-time"]) {
    field(name).addEventListener("change", render)
  }
  for (const picker of schedule.querySelectorAll<HTMLInputElement>(".pick input")) {
    picker.addEventListener("click", () => {
      try {
        picker.showPicker()
      } catch {}
    })
  }
  render()
  const picker = input("video")
  const label = document.querySelector<HTMLElement>("[data-file]")!
  const posterInput = document.querySelector<HTMLInputElement>("[data-poster]")!
  const reject = (text: string) => {
    picker.value = ""
    posterInput.value = ""
    label.textContent = text
  }

  // Checked here because the server can only see the size; the still is grabbed for list thumbnails.
  picker.addEventListener("change", async () => {
    const file = picker.files?.[0]
    posterInput.value = ""
    if (!file) return (label.textContent = "选择一段视频")
    if (file.size > Number(picker.dataset.maxMb) * 1024 * 1024) return reject(`视频超过 ${picker.dataset.maxMb}MB。`)
    const video = Object.assign(document.createElement("video"), {
      src: URL.createObjectURL(file),
      muted: true,
      loop: true,
      autoplay: true,
      playsInline: true,
    })
    const once = (name: string, ms: number) =>
      new Promise<boolean>((done) => {
        video.addEventListener(name, () => done(true), { once: true })
        video.addEventListener("error", () => done(false), { once: true })
        setTimeout(() => done(false), ms)
      })
    // Duration needs only metadata, which every browser loads; frame data may never arrive on iOS
    // for a video outside the page, so the still is a best effort that never blocks the upload.
    if (!(await once("loadedmetadata", 8000))) return reject("视频打不开，换成 MP4 试试。")
    if (video.duration > Number(picker.dataset.maxSeconds)) return reject(`视频有 ${Math.round(video.duration)} 秒，需在 ${picker.dataset.maxSeconds} 秒以内。`)
    label.textContent = file.name
    document.querySelector<HTMLElement>(".preview [data-bind=footage]")?.replaceChildren(video)

    if (video.readyState < 2 && !(await once("loadeddata", 3000))) return
    const scale = Math.min(1, 360 / video.videoWidth)
    const canvas = new OffscreenCanvas(Math.round(video.videoWidth * scale), Math.round(video.videoHeight * scale))
    canvas.getContext("2d")!.drawImage(video, 0, 0, canvas.width, canvas.height)
    const still = await canvas.convertToBlob({ type: "image/webp", quality: 0.8 })
    if (still.type === "image/webp" && picker.files?.[0] === file) {
      const files = new DataTransfer()
      files.items.add(new File([still], "poster.webp", { type: "image/webp" }))
      posterInput.files = files.files
    }
  })
  const form = document.querySelector<HTMLFormElement>("form.sheets")!
  const limit = document.querySelector<HTMLInputElement>("[data-limit]")!
  const count = document.querySelector<HTMLElement>(".count")!
  const capacity = count.querySelector("input")!
  limit.addEventListener("change", () => {
    count.hidden = !limit.checked
    capacity.disabled = !limit.checked
    if (limit.checked) capacity.focus()
  })

  const people = document.querySelector<HTMLElement>("[data-people]")!
  const find = document.querySelector<HTMLInputElement>("[data-find]")!
  const list = document.querySelector("ul[data-results]") as HTMLUListElement
  const person = (el: HTMLElement) => el.querySelector("input")!
  const toggle = (el: HTMLElement, on: boolean) => {
    person(el).checked = on
    el.hidden = !on
    form.dispatchEvent(new Event("input"))
  }
  people.addEventListener("click", (e) => {
    const remove = (e.target as Element).closest("[data-remove]")
    if (remove) toggle(remove.closest<HTMLElement>("[data-person]")!, false)
  })
  const showResults = () => {
    const query = find.value.trim().toLowerCase()
    const matches = query
      ? [...people.querySelectorAll<HTMLElement>("[data-person]")].filter((el) => el.hidden && el.dataset.person!.includes(query)).slice(0, 6)
      : []
    const items = matches.map((el) => {
      const item = document.createElement("li")
      const button = Object.assign(document.createElement("button"), { type: "button", textContent: el.dataset.name! })
      button.addEventListener("click", () => {
        toggle(el, true)
        find.value = ""
        showResults()
        find.focus()
      })
      item.replaceChildren(button)
      return item
    })
    if (query && !matches.length) items.push(Object.assign(document.createElement("li"), { className: "empty", textContent: "没有找到这位社员。" }))
    list.replaceChildren(...items)
    list.hidden = !query
  }
  find.addEventListener("input", showResults)
  find.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault()
      list.querySelector("button")?.click()
    }
    if (e.key === "Escape") {
      find.value = ""
      showResults()
    }
  })

  // The form keeps its first snapshot so undoing an edit by hand also clears the unsaved state.
  const save = form.querySelector<HTMLButtonElement>("[data-submit] button")!
  const state = form.querySelector<HTMLElement>("[data-state]")!
  const isNew = save.textContent === "发布活动"
  const snapshot = () =>
    JSON.stringify([...new FormData(form)].map(([k, v]) => [k, typeof v === "string" ? v : `${v.name}:${v.size}`]))
  const first = snapshot()
  // A rejected save comes back with the submitted values, which still differ from what is stored.
  const failed = !isNew && !save.disabled
  let dirty = failed
  let sending = false
  const refresh = () => {
    if (isNew) return
    dirty = failed || snapshot() !== first
    save.disabled = !dirty
    state.textContent = dirty ? (failed ? "还没有保存" : "有未保存的修改") : state.textContent === "已保存" ? "已保存" : "没有未保存的修改"
  }
  form.addEventListener("input", refresh)
  form.addEventListener("change", refresh)
  form.addEventListener("submit", () => {
    sending = true
    save.disabled = true
    save.textContent = isNew ? "正在发布…" : "正在保存…"
  })
  addEventListener("beforeunload", (e) => {
    if ((dirty || (isNew && snapshot() !== first)) && !sending) e.preventDefault()
  })
  if (new URL(location.href).searchParams.has("saved")) history.replaceState(null, "", location.pathname)
  form.querySelector<HTMLElement>("[aria-invalid]")?.focus()
</script>

<style>
  .schedule {
    display: grid;
    gap: 0.9rem;
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
  }

  .row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .range {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .range i {
    font-style: normal;
    color: var(--faint);
  }

  .form .pick {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.6rem;
    padding: 0 0.95rem;
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    background: var(--field);
    color: var(--fg);
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form .pick[hidden] {
    display: none;
  }

  .form .pick:has(input:focus-visible) {
    border-color: rgb(59 141 255 / 0.7);
    box-shadow: 0 0 0 4px rgb(59 141 255 / 0.15);
  }

  /* The native control sits invisibly on top so a tap opens the system picker, including on iOS. */
  .form .pick input {
    position: absolute;
    inset: 0;
    width: 100%;
    min-height: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    cursor: pointer;
