---
import { formatDot } from "../lib/time"

interface Props {
  event: { slug: string; title: string; word: string; starts_at: string }
  // The pass id, so each holder's impression lands at its own angle and wears its own way.
  seed: string
  ink?: string
  class?: string
}

const { event, seed, ink: given, class: className } = Astro.props
const hash = (s: string) => {
  const h = [...s].reduce((h, c) => Math.imul(h ^ c.charCodeAt(0), 0x45d9f3b), 7)
  return (Math.imul(h ^ (h >>> 16), 0x45d9f3b) ^ (h >>> 15)) >>> 0
}
const INKS = ["#c8372a", "#2449b8", "#1d6e4a", "#6a3aa8", "#a8541c"]
const ink = given ?? INKS[hash(event.slug) % INKS.length]
const h = hash(seed)
const turn = (h % 31) - 15
const grit = `${h % 240}px ${(h >> 8) % 240}px`
const word = event.word.toUpperCase()
const units = [...word].reduce((sum, c) => sum + (/[⺀-￯]/.test(c) ? 1 : 0.45), 0)
const size = Math.min(54, 92 / Math.max(units, 1))
const id = `arc-${h.toString(36)}`
---

<svg class:list={["stamp-mark", className]} viewBox="0 0 200 200" role="img" aria-label={`${event.title} 印章`} style={`--ink: ${ink}; --turn: ${turn}deg; --grit: ${grit}`}>
  <defs>
    <path id={`${id}-top`} d="M34 100a66 66 0 0 1 132 0" />
    <path id={`${id}-bottom`} d="M24 100a76 76 0 0 0 152 0" />
  </defs>
  <circle cx="100" cy="100" r="95" fill="none" stroke-width="5" />
  <circle cx="100" cy="100" r="87" fill="none" stroke-width="1.5" />
  <circle cx="100" cy="100" r="54" fill="none" stroke-width="1.5" />
  <text class="arc"><textPath href={`#${id}-top`} startOffset="50%" text-anchor="middle">{event.title.length > 10 ? `${event.title.slice(0, 9)}…` : event.title}</textPath></text>
  <text class="arc date"><textPath href={`#${id}-bottom`} startOffset="50%" text-anchor="middle" data-stamp-date>{`NBTCA · ${formatDot(event.starts_at)}`}</textPath></text>
  <text class="word" x="100" y="100" font-size={size} dominant-baseline="central" text-anchor="middle">{word}</text>
  <path class="star" d="M18 100l3-3 3 3-3 3zM176 100l3-3 3 3-3 3z" />
</svg>

<style>
  .stamp-mark {
    display: block;
    aspect-ratio: 1;
    color: var(--ink);
    rotate: var(--turn);
    mix-blend-mode: multiply;
    opacity: 0.88;
    mask:
      url("/stamp-ink.svg") var(--grit) / 120px,
      linear-gradient(calc(var(--turn) * 4 + 120deg), #000 40%, rgb(0 0 0 / 0.55));
    mask-composite: intersect;
  }

  circle {
    stroke: currentColor;
  }

  text {
    fill: currentColor;
  }

  .arc {
    font: 700 15px / 1 system-ui, -apple-system, "PingFang SC", sans-serif;
    letter-spacing: 0.12em;
  }

  .date {
    font: 600 13px / 1 var(--wide);
    letter-spacing: 0.18em;
  }

  .word {
    font-family: var(--display);
    font-weight: 400;
  }

  .star {
    fill: currentColor;
  }
</style>
