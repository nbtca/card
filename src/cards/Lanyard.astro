---
interface Props {
  attach?: number
  drop?: boolean
}

const { attach = 0.051, drop = false } = Astro.props
const id = `strap-${Math.random().toString(36).slice(2, 8)}`
---

<div class="lanyard" data-lanyard data-drop={drop ? "" : undefined} style={`--attach: ${attach}`}>
  <svg class="strap" aria-hidden="true">
    <defs>
      <linearGradient id={`${id}-band`} x1="0" x2="1">
        <stop offset="0" stop-color="#0a2f57" />
        <stop offset="0.5" stop-color="#1d5fa8" />
        <stop offset="1" stop-color="#0a2f57" />
      </linearGradient>
    </defs>
    <path id={id} class="band" stroke={`url(#${id}-band)`} />
    <text><textPath href={`#${id}`} startOffset="0">{"NBTCA ✦ ".repeat(40)}</textPath></text>
    <g class="clip"><rect x="-9" y="-14" width="18" height="22" rx="4" /><circle r="3.2" cy="4" /></g>
  </svg>
  <div class="hang"><slot /></div>
</div>

<script>
  import { land, tap } from "../lib/sound"

  const motion = matchMedia("(prefers-reduced-motion: no-preference)")
  const G = 2600
  const K = 70
  const DAMP = 4.2
  const STEP = 1 / 120
  const STRETCH = 140
  const THROW = 2200

  for (const root of document.querySelectorAll<HTMLElement>("[data-lanyard]")) {
    const hang = root.querySelector<HTMLElement>(".hang")!
    const band = root.querySelector<SVGPathElement>(".band")!
    const clip = root.querySelector<SVGGElement>(".clip")!
    const attach = Number(getComputedStyle(root).getPropertyValue("--attach"))

    let rest = { x: 0, y: 0 }
    let pivot = { x: 0, y: 0 }
    let length = 0
    let pos = { x: 0, y: 0 }
    let vel = { x: 0, y: 0 }
    let grab: { dx: number; dy: number; t: number; x: number; y: number } | null = null
    let frame = 0
    let last = 0
    let falling = false

    const measure = () => {
      const box = root.getBoundingClientRect()
      rest = { x: box.width / 2, y: hang.offsetHeight * attach }
      pivot = { x: rest.x, y: -(box.top + scrollY) - 40 }
      // Gravity stretches the spring by G / K, so its natural length is shorter than the drawn rest distance.
      length = rest.y - pivot.y - G / K
    }

    const draw = () => {
      const angle = Math.atan2(pos.x - pivot.x, pos.y - pivot.y)
      hang.style.transform = `translate(${pos.x - rest.x}px, ${pos.y - rest.y}px) rotate(${-angle}rad)`
      const sag = Math.max(0, length + G / K - Math.hypot(pos.x - pivot.x, pos.y - pivot.y)) * 0.6
      const mx = (pivot.x + pos.x) / 2 - vel.x * 0.04 + sag * 0.3
      const my = (pivot.y + pos.y) / 2
      band.setAttribute("d", `M${pivot.x} ${pivot.y} Q${mx} ${my} ${pos.x} ${pos.y}`)
      clip.setAttribute("transform", `translate(${pos.x} ${pos.y}) rotate(${(-angle * 180) / Math.PI})`)
    }

    const tick = (now: number) => {
      let dt = Math.min(0.05, (now - last) / 1000)
      last = now
      if (!grab) {
        while (dt > 0) {
          const h = Math.min(STEP, dt)
          const dx = pos.x - pivot.x
          const dy = pos.y - pivot.y
          const dist = Math.hypot(dx, dy) || 1
          const pull = (-K * (dist - length)) / dist
          vel.x += (pull * dx - DAMP * vel.x) * h
          vel.y += (pull * dy + G - DAMP * vel.y) * h
          pos.x += vel.x * h
          pos.y += vel.y * h
          dt -= h
          if (falling && pos.y >= rest.y) {
            falling = false
            land()
          }
        }
      }
      draw()
      const settled = !grab && Math.hypot(vel.x, vel.y) < 2 && Math.hypot(pos.x - rest.x, pos.y - rest.y) < 0.5
      if (settled) {
        pos = { ...rest }
        vel = { x: 0, y: 0 }
        draw()
        frame = 0
      } else {
        frame = requestAnimationFrame(tick)
      }
    }

    const wake = () => {
      if (frame) return
      last = performance.now()
      frame = requestAnimationFrame(tick)
    }

    measure()
    pos = { ...rest }
    if (motion.matches && root.hasAttribute("data-drop")) {
      pos.y -= 260
      pos.x += 40
      falling = true
      wake()
    } else {
      draw()
    }

    hang.addEventListener("pointerdown", (e) => {
      if (!motion.matches) return
      e.preventDefault()
      hang.setPointerCapture(e.pointerId)
      const box = root.getBoundingClientRect()
      const px = e.clientX - box.left
      const py = e.clientY - box.top
      grab = { dx: pos.x - px, dy: pos.y - py, t: performance.now(), x: px, y: py }
      vel = { x: 0, y: 0 }
      root.dataset.grabbed = ""
      wake()
    })
    // Stiff past its hanging length, or a hard pull flings the pass off the screen.
    const leash = (x: number, y: number) => {
      const dx = x - pivot.x
      const dy = y - pivot.y
      const dist = Math.hypot(dx, dy) || 1
      const hanging = rest.y - pivot.y
      if (dist <= hanging) return { x, y }
      const k = (hanging + STRETCH * (1 - Math.exp(-(dist - hanging) / STRETCH))) / dist
      return { x: pivot.x + dx * k, y: pivot.y + dy * k }
    }

    hang.addEventListener("pointermove", (e) => {
      if (!grab) return
      const box = root.getBoundingClientRect()
      const px = e.clientX - box.left
      const py = e.clientY - box.top
      const now = performance.now()
      const dt = Math.max(8, now - grab.t) / 1000
      const next = leash(px + grab.dx, py + grab.dy)
      // Smoothed and capped, so one jittery pointer event cannot become a throw.
      const speed = { x: (next.x - pos.x) / dt, y: (next.y - pos.y) / dt }
      vel = { x: vel.x * 0.5 + speed.x * 0.5, y: vel.y * 0.5 + speed.y * 0.5 }
      const fast = Math.hypot(vel.x, vel.y)
      if (fast > THROW) vel = { x: (vel.x * THROW) / fast, y: (vel.y * THROW) / fast }
      pos = next
      Object.assign(grab, { t: now, x: px, y: py })
    })
    const release = () => {
      if (grab) tap()
      grab = null
      delete root.dataset.grabbed
      wake()
    }
    hang.addEventListener("pointerup", release)
    hang.addEventListener("pointercancel", release)
    addEventListener("resize", () => {
      measure()
      pos = { ...rest }
      draw()
    })
  }
</script>

<style>
  .lanyard {
    position: relative;
    width: 100%;
    display: grid;
    justify-items: center;
  }

  .strap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .band {
    fill: none;
    stroke-width: 20;
    stroke-linecap: round;
  }

  text {
    font: 800 9px / 1 var(--wide);
    font-stretch: 125%;
    letter-spacing: 0.24em;
    fill: rgb(255 255 255 / 0.75);
    dominant-baseline: central;
  }

  .clip rect {
    fill: #c9ced8;
    stroke: #8d95a3;
  }

  .clip circle {
    fill: var(--bg);
  }

  .hang {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    width: 100%;
    transform-origin: 50% calc(var(--attach) * 100%);
    pointer-events: none;
    will-change: transform;
  }

  .hang > :global(*) {
    pointer-events: auto;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }

  [data-grabbed] .hang > :global(*) {
    cursor: grabbing;
  }

  [data-grabbed] .hang {
    cursor: grabbing;
  }
</style>
