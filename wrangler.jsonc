{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "card",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "routes": [{ "pattern": "card.nbtca.space", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://nbtca.cloudflareaccess.com",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "contact@m1ng.space,clas.wen@icloud.com"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "card", "database_id": "", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "card" }]
}
