{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "card",
  "account_id": "a415a3ae7a197093d02233755d38800b",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "routes": [{ "pattern": "card.nbtca.space", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://nbtca.cloudflareaccess.com",
    "ACCESS_AUD": "f2dc1e37e5658c78d88715a512acfb0069a98e7d63319ab8523d36d00be255c1",
    "MEMBER_ROLES": "Repair Member,Repair Admin,Admin",
    "ADMIN_ROLES": "Repair Admin,Admin"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "card", "database_id": "643f54b7-6b92-43b6-95d4-18e2a7fc5a3e", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "card" }]
}
