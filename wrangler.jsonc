{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "card",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "routes": [{ "pattern": "card.nbtca.space", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "LOGTO_ENDPOINT": "https://auth.app.nbtca.space",
    "LOGTO_APP_ID": "",
    "SATURDAY_API": "https://api.nbtca.space"
  },
  // LOGTO_APP_SECRET and SESSION_SECRET are set with `wrangler secret put`.
  "d1_databases": [{ "binding": "DB", "database_name": "card", "database_id": "", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "card" }]
}
